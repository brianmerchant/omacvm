# The mac-ime feature's Fcitx5 module (docs/adr/0043-mac-ime.md): the Mac's
# input methods type into Omarchy through the Fcitx5 that Omarchy runs.
# Built in the VM against its own Fcitx5 (install.sh here copies the sources
# next to this file first), installed with pacman: `pacman -R
# omacvm-fcitx5-ime` removes all of it. The sources are OmacVM's own copy in
# the VM (checked by omacvm apply's digests), hence SKIP.
pkgname=omacvm-fcitx5-ime
pkgver=1.0.0
pkgrel=1
pkgdesc="Fcitx5 module: macOS input methods for Omarchy in OmacVM.app (OmacVM's mac-ime feature)"
arch=(aarch64)
url="https://github.com/gillesgoetsch/OmacVM"
license=(MIT)
depends=(fcitx5 gcc-libs glibc)
makedepends=(pkgconf)
options=(!debug)
source=(omacvmime.cpp protocol.cpp protocol.h omacvmime.conf)
sha256sums=(SKIP SKIP SKIP SKIP)

build() {
  # shellcheck disable=SC2046 # pkg-config's flags, one per word
  g++ -std=c++20 -O2 -fPIC -shared -fvisibility=hidden -Wall -Wextra \
    $CPPFLAGS $CXXFLAGS $(pkg-config --cflags Fcitx5Core Fcitx5Utils) \
    omacvmime.cpp protocol.cpp -o libomacvmime.so \
    $LDFLAGS -Wl,--as-needed $(pkg-config --libs Fcitx5Core Fcitx5Utils)
}

package() {
  install -Dm755 libomacvmime.so "$pkgdir/usr/lib/fcitx5/libomacvmime.so"
  install -Dm644 omacvmime.conf "$pkgdir/usr/share/fcitx5/addon/omacvmime.conf"
  # What it was built from and for (install.sh --status compares).
  install -d "$pkgdir/usr/lib/omacvm-ime"
  { echo "source $(cat omacvmime.cpp protocol.cpp protocol.h omacvmime.conf | sha256sum | cut -c1-16)"
    echo "fcitx5 $(pacman -Q fcitx5 | awk '{ print $2 }')"; } > "$pkgdir/usr/lib/omacvm-ime/build-info"
}

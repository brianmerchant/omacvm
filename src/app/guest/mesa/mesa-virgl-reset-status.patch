+/* The host loses the whole context (every pipe_context of this screen) on a fatal
+ * error and writes VIRGL_RESET_STATUS_GUILTY into the screen's status buffer. */
+static enum pipe_reset_status
+virgl_get_device_reset_status(struct pipe_context *ctx)
+{
+   struct virgl_screen *rs = virgl_screen(ctx->screen);
+
+   if (rs->reset_status &&
+       p_atomic_read(rs->reset_status) == VIRGL_RESET_STATUS_GUILTY)
+      return PIPE_GUILTY_CONTEXT_RESET;
+   return PIPE_NO_RESET;
+}
+
+static void
+virgl_set_device_reset_callback(struct pipe_context *ctx,
+                                const struct pipe_device_reset_callback *cb)
+{
+   struct virgl_context *vctx = virgl_context(ctx);
+
+   if (cb)
+      vctx->reset_callback = *cb;
+   else
+      memset(&vctx->reset_callback, 0, sizeof(vctx->reset_callback));
+}
+
+static struct virgl_hw_res *
+virgl_get_reset_status_buffer(struct virgl_screen *rs)
+{
+   struct virgl_winsys *vws = rs->vws;
+
+   simple_mtx_lock(&rs->reset_status_lock);
+   if (!rs->reset_status_res) {
+      struct virgl_hw_res *res =
+         vws->resource_create(vws, PIPE_BUFFER, NULL, PIPE_FORMAT_R8_UNORM,
+                              VIRGL_BIND_CUSTOM, 64, 1, 1, 1, 0, 0, 0, 64);
+      uint32_t *map = res ? vws->resource_map(vws, res) : NULL;
+      if (map) {
+         p_atomic_set(map, 0);
+         rs->reset_status_res = res;
+         rs->reset_status = map;
+      } else if (res) {
+         vws->resource_reference(vws, &res, NULL);
+      }
+   }
+   simple_mtx_unlock(&rs->reset_status_lock);
+   return rs->reset_status_res;
+}
+
 void virgl_flush_eq(struct virgl_context *ctx, void *closure,
                     struct pipe_fence_handle **fence)
 {
@@ -1104,6 +1154,21 @@ void virgl_flush_eq(struct virgl_context *ctx, void *closure,
 
    virgl_submit_cmd(rs->vws, ctx->cbuf, fence);
 
+   if (!ctx->reset_reported &&
+       virgl_get_device_reset_status(&ctx->base) != PIPE_NO_RESET) {
+      ctx->reset_reported = true;
+      if (ctx->reset_callback.reset) {
+         ctx->reset_callback.reset(ctx->reset_callback.data, PIPE_GUILTY_CONTEXT_RESET);
+      } else if (!debug_get_bool_option("VIRGL_KEEP_LOST_CONTEXT", false)) {
+         /* The app did not ask for reset notification, so it would draw into a dead
+          * context for good. End it like venus does on a fatal ring status: a
+          * browser then restarts its GPU process and the page gets its context back. */
+         mesa_loge("virgl: the host lost this GL context and the app asked for no reset "
+                   "notification; aborting (VIRGL_KEEP_LOST_CONTEXT=1 keeps it)");
+         abort();
+      }
+   }
+
    /* Reserve some space for transfers. */
    if (ctx->encoded_transfers)
       ctx->cbuf->cdw = VIRGL_MAX_TBUF_DWORDS;
@@ -1859,6 +1924,14 @@ struct pipe_context *virgl_context_create(struct pipe_screen *pscreen,
    if (rs->caps.caps.v2.capability_bits & VIRGL_CAP_APP_TWEAK_SUPPORT)
       virgl_send_tweaks(vctx, rs);
 
+   if (rs->caps.caps.v2.capability_bits_v2 & VIRGL_CAP_V2_RESET_STATUS_BUFFER) {
+      struct virgl_hw_res *status = virgl_get_reset_status_buffer(rs);
+      if (status)

#!/bin/bash
# Enable the OmacVM bar widgets queued in ~/.local/state/omacvm/pending-plugins,
# disable the ones in pending-plugins-off (a feature switched off while nobody
# was logged in) and set the clock queued in pending-clock, once the Omarchy
# shell answers. Run as the desktop user (at login by
# omacvm-plugins.service, or directly by lib/install-plugin.sh).
set -uo pipefail
[[ -n ${OMARCHY_PATH:-} ]] || source /usr/share/omarchy/default/bash/env-bootstrap 2>/dev/null
Q=${XDG_STATE_HOME:-$HOME/.local/state}/omacvm/pending-plugins
CL=${XDG_STATE_HOME:-$HOME/.local/state}/omacvm/pending-clock
OFF=${XDG_STATE_HOME:-$HOME/.local/state}/omacvm/pending-plugins-off
[[ -s $Q || -s $CL || -s $OFF ]] || exit 0
for _ in $(seq 60); do omarchy-shell shell ping >/dev/null 2>&1 && break; sleep 1; done
if [[ -s $OFF ]] && omarchy-shell shell ping >/dev/null 2>&1; then
  while read -r id; do
    [[ -n $id ]] && omarchy plugin disable "$id" >/dev/null 2>&1 && echo "plugin $id disabled"
  done < "$OFF"
  rm -f "$OFF"
fi
if [[ -s $CL ]]; then
  /usr/local/share/omacvm/clock/guest/clock.sh "$(id -un)" on "$(cat "$CL")" && rm -f "$CL"
fi
[[ -s $Q ]] || exit 0
omarchy-shell -q shell rescanPlugins
left=()
while read -r id; do
  [[ -n $id ]] || continue
  dir=$HOME/.config/omarchy/plugins/$id
  if [[ -x $dir/placement.sh ]]; then (cd "$dir" && ./placement.sh) && ok=1 || ok=0
  else omarchy plugin enable "$id" >/dev/null && ok=1 || ok=0; fi
  if (( ok )); then echo "plugin $id enabled"; else left+=("$id"); fi
done < "$Q"
printf '%s\n' "${left[@]}" | grep . > "$Q.new" || true
mv "$Q.new" "$Q"

[Unit]
Description=OmacVM: the Omarchy theme's colours for the Mac's Touch ID panel
# A theme switch rewrites many files, each one triggers the path unit.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Waits for the switch's files to settle (0.8 s quiet, at most 3 s), sends,
# and looks once more 1.5 s later (Hyprland reloads its border and rounding last).
ExecStart=/usr/lib/omacvm/omacvm-touchid-theme

[Install]
WantedBy=default.target

#!/usr/bin/python3 -I
"""omacvm-touchid-theme: the Omarchy theme's colours for the Mac's Touch ID
panel (ADR 0041, addendum 3.0.2). Runs as the desktop user: from
omacvm-touchid-theme.path when the theme changes, and once at login.

Sends colours and a corner radius only, signed with this VM's control key
(POST /omacvm/theme, through the control centre's client): the panel's words
and its font never come from the VM. The Mac checks them again and keeps the
last good theme per VM (also while Touch ID is off); until one arrives it
draws Tokyo Night.

The panel looks like Omarchy's own password prompt: from
~/.local/state/omarchy/current/theme, shell.toml's [polkit] (background,
text, accent, text-error, border), else colors.toml; Hyprland's
general:col.active_border (the border, a gradient too) and
decoration:rounding.

Sent once per change and boot: at login (the Mac may have lost its copy),
when Touch ID is switched on (touchid.sh clears the record), and on a theme
switch once its files have settled; a second look 1.5 s later sends it again
if Hyprland's border or rounding changed meanwhile (a switch reloads
Hyprland last).

  omacvm-touchid-theme            send it when it changed since the last time
  omacvm-touchid-theme --force    send it anyway
  omacvm-touchid-theme --print    print it, send nothing
"""
import glob
import json
import os
import re
import subprocess
import sys
import time
import tomllib

E = os.environ
HOME = os.path.expanduser("~")
THEME = E.get("OMACVM_TOUCHID_THEME_DIR", HOME + "/.local/state/omarchy/current/theme")
STATE = E.get("OMACVM_TOUCHID_THEME_STATE", E.get("XDG_STATE_HOME", HOME + "/.local/state") + "/omacvm/touchid-theme-sent")
SHARE = E.get("OMACVM_SHARE", "/usr/local/share/omacvm")
HYPRCTL = E.get("OMACVM_HYPRCTL", "hyprctl")
DELAY = float(E.get("OMACVM_TOUCHID_THEME_DELAY", "3"))   # a theme switch writes many files: at most this long ...
QUIET = min(DELAY, 0.8)                                    # ... for them to be this long untouched
# Hyprland reloads its border and rounding last in a switch: one more look after this.
RECHECK = float(E.get("OMACVM_TOUCHID_THEME_RECHECK", "1.5"))
BOOT = E.get("OMACVM_TOUCHID_THEME_BOOT", "/proc/sys/kernel/random/boot_id")
HEX = re.compile(r"#[0-9a-fA-F]{6}")


def toml(name: str) -> dict:
    try:
        with open(os.path.join(THEME, name), "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def colour(v) -> str | None:
    """'#rrggbb' (an '#rrggbbaa' loses its alpha: the Mac's card is opaque)."""
    if isinstance(v, str) and HEX.fullmatch(v[:7]) and len(v) in (7, 9):
        return v[:7].lower()
    return None


def hypr_colour(tok: str) -> str | None:
    """One of Hyprland's colours: '#rrggbb', 'rgb(rrggbb)', 'rgba(rrggbbaa)',
    'rgb(r,g,b)', 'rgba(r,g,b,a)' or '0xaarrggbb' -> '#rrggbb'."""
    c = colour(tok)
    if c:
        return c
    m = re.fullmatch(r"rgba?\(([0-9a-fA-F]{6})(?:[0-9a-fA-F]{2})?\)", tok) or re.fullmatch(r"0x[0-9a-fA-F]{2}([0-9a-fA-F]{6})", tok)
    if m:
        return "#" + m.group(1).lower()
    m = re.fullmatch(r"rgba?\((\d{1,3}),(\d{1,3}),(\d{1,3})(?:,[0-9.]+)?\)", tok)
    if m and all(int(x) <= 255 for x in m.groups()):
        return "#" + "".join(f"{int(x):02x}" for x in m.groups())
    return None


def border_value(v) -> tuple[list[str], float] | None:
    """shell.toml's border: one colour, or Hyprland's gradient ('rgba(7aa2f7ee)
    rgba(bb9af7ee) 45deg') -> (colours, angle). The panel draws two colours:
    a longer gradient keeps its first and its last. Anything else (a
    $variable): None."""
    if not isinstance(v, str):
        return None
    # rgba(51, 204, 255, 0.9): one token without the spaces.
    v = re.sub(r"\(\s*([^)]*?)\s*\)", lambda m: "(" + re.sub(r"\s*,\s*", ",", m.group(1)) + ")", v.strip())
    cols, angle = [], 0.0
    for tok in v.split():
        c = hypr_colour(tok)
        if c:
            cols.append(c)
        elif re.fullmatch(r"-?[0-9.]+deg", tok):
            try:
                angle = float(tok[:-3])
            except ValueError:
                pass
        else:
            return None
    if not cols:
        return None
    return ([cols[0], cols[-1]] if len(cols) > 1 else cols), angle


def settle():
    """A theme switch writes many files (and Hyprland reloads its rounding):
    wait until the theme's files are QUIET seconds old, at most DELAY."""
    end = time.monotonic() + DELAY
    while True:
        newest = 0.0
        for d in (THEME, os.path.dirname(THEME)):
            try:
                newest = max(newest, os.stat(d).st_mtime)
                entries = list(os.scandir(d))
            except OSError:
                continue
            for e in entries:   # one renamed away mid-switch is skipped, not the folder
                try:
                    newest = max(newest, e.stat().st_mtime)
                except OSError:
                    pass
        left = QUIET - (time.time() - newest)
        if left <= 0 or time.monotonic() >= end:
            return
        time.sleep(min(left, max(end - time.monotonic(), 0)) + 0.01)


def hypr_env() -> dict:
    """hyprctl needs the session's instance; a user service may not have it."""
    env = dict(E)
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
        socks = sorted(glob.glob(run + "/hypr/*/.socket.sock"), key=os.path.getmtime)
        if socks:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(os.path.dirname(socks[-1]))
            env.setdefault("XDG_RUNTIME_DIR", run)
    return env


def hypr_option(name: str) -> dict:
    try:
        out = subprocess.run([HYPRCTL, "-j", "getoption", name], capture_output=True, timeout=3, env=hypr_env(), check=False).stdout
        o = json.loads(out)
        return o if isinstance(o, dict) else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


def hypr_border(o: dict) -> tuple[list[str], float] | None:
    """Hyprland's 'ff7aa2f7 ffbb9af7 45deg' (ARGB) -> (['#7aa2f7', '#bb9af7'], 45)."""
    g = o.get("gradient")
    if not isinstance(g, str):
        return None
    cols, angle = [], 0.0
    for tok in g.split():
        if re.fullmatch(r"[0-9a-fA-F]{8}", tok):
            cols.append("#" + tok[2:].lower())
        elif re.fullmatch(r"-?[0-9.]+deg", tok):
            try:
                angle = float(tok[:-3])
            except ValueError:
                pass
    if not cols:
        return None
    return ([cols[0], cols[-1]] if len(cols) > 1 else cols), angle


def theme() -> dict | None:
    colors, shell = toml("colors.toml"), toml("shell.toml")
    polkit = shell.get("polkit") if isinstance(shell.get("polkit"), dict) else {}
    hypr = shell.get("hyprland") if isinstance(shell.get("hyprland"), dict) else {}

    def ref(v):
        """A [polkit] value: a colour, or one of the [hyprland] tokens it names."""
        if isinstance(v, str) and v.startswith("hyprland."):
            v = hypr.get(v[len("hyprland."):])
        return v

    bg = colour(ref(polkit.get("background"))) or colour(colors.get("background"))
    fg = colour(ref(polkit.get("text"))) or colour(colors.get("foreground"))
    if not bg or not fg:
        return None
    # The prompt's accent is its lock glyph's colour.
    accent = colour(ref(polkit.get("accent"))) or colour(colors.get("accent")) or fg
    out = {"background": bg, "foreground": fg, "accent": accent,
           "error": colour(ref(polkit.get("text-error"))) or colour(colors.get("red")) or fg}
    # The panel's "done", and the lines of the 3.0.2/3.0.3 panels (the Mac checks their contrast).
    for key, name in (("success", "green"), ("muted", "muted")):
        c = colour(colors.get(name))
        if c:
            out[key] = c
    # The prompt's border: Hyprland's active border as Hyprland has it now
    # (the theme's or the person's own), unless the theme gives the prompt its own.
    pb = polkit.get("border", "hyprland.active-border")
    own = None if pb == "hyprland.active-border" else border_value(ref(pb))
    border = own or hypr_border(hypr_option("general:col.active_border")) or border_value(hypr.get("active-border"))
    out["border"] = border[0] if border else [accent]
    if border and len(border[0]) == 2:
        out["border_angle"] = border[1]
    r = hypr_option("decoration:rounding").get("int")
    out["radius"] = r if isinstance(r, int) and not isinstance(r, bool) else 0
    return out


def main(argv: list[str]) -> int:
    if "--print" in argv:
        t = theme()
        if t is None:
            print("omacvm-touchid-theme: no Omarchy theme found", file=sys.stderr)
        else:
            print(json.dumps(t, sort_keys=True, separators=(",", ":")))
        return 0
    if DELAY > 0:
        settle()
    send("--force" in argv)
    if DELAY > 0 and RECHECK > 0:
        time.sleep(RECHECK)
        send(False)   # sent again only if Hyprland's values changed meanwhile
    return 0


def send(force: bool) -> None:
    """The theme to the Mac, unless the Mac has it from this boot already."""
    t = theme()
    if t is None:
        print("omacvm-touchid-theme: no Omarchy theme found", file=sys.stderr)
        return
    body = json.dumps(t, sort_keys=True, separators=(",", ":"))
    # Once per change and boot: a new boot (a login) sends it again.
    try:
        with open(BOOT, encoding="utf-8") as f:
            sent = f.read().strip() + "\n" + body
    except OSError:
        sent = body
    try:
        with open(STATE, encoding="utf-8") as f:
            if f.read() == sent and not force:
                return
    except OSError:
        pass
    sys.path.insert(0, os.path.join(SHARE, "control"))
    try:
        from omacvm_cc.bridge import Bridge, BridgeError
        from omacvm_cc import state as S
    except ImportError:
        print("omacvm-touchid-theme: OmacVM's control client is missing (omacvm apply on the Mac)", file=sys.stderr)
        return
    try:
        with open(E.get("OMACVM_ENV", "/etc/omacvm/env"), encoding="utf-8", errors="replace") as f:
            env = S.parse_env(f.read())
    except OSError:
        env = {}
    try:
        with open(os.path.join(SHARE, "VERSION"), encoding="utf-8") as f:
            version = f.read().strip() or "?"
    except OSError:
        version = "?"
    try:
        Bridge(env, version).call("POST", "/omacvm/theme", t, timeout=5.0)
    except BridgeError as e:
        # Retried at the next theme change or login; the Mac keeps the last theme meanwhile.
        print(f"omacvm-touchid-theme: not sent: {e}", file=sys.stderr)
        return
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".new", "w", encoding="utf-8") as f:
        f.write(sent)
    os.replace(STATE + ".new", STATE)
    print(f"omacvm-touchid-theme: {t['background']} on {t['foreground']} -> the Mac")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

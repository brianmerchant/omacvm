[Unit]
Description=Omanotch: stream the Omarchy bar to the macOS notch helper
Documentation=https://github.com/gillesgoetsch/omacvm/tree/main/src/omanotch
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/notchcast
Restart=always
RestartSec=2
# The display panel without NOTCH, built again when an Omarchy update changed it.
ExecStartPost=-%h/.local/bin/omanotch-display-panel --refresh
# Belt and braces: never leave the guest cursor hidden.
ExecStopPost=-/usr/bin/hyprctl eval "hl.config({ cursor = { invisible = false } })"
# ... and bring the bar back right away instead of after the bar's watchdog.
ExecStopPost=-/usr/bin/qs ipc -n -p /usr/share/omarchy/shell call notchbar setParked false

[Install]
WantedBy=graphical-session.target

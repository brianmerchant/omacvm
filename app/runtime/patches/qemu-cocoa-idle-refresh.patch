+/*
+ * QEMU's refresh tick (gui_update) runs at the Mac display's rate for every
+ * listener: 120 wakeups a second on a ProMotion panel, also while the guest
+ * shows nothing new. With virtio-gpu the main window's GL frames do not need
+ * it (dpy_gl_update puts them on screen, or the present timer and display
+ * link do) and the device's gfx_update does nothing. What still needs the
+ * tick: 2D updates and new scanouts (boot, consoles), the extra outputs'
+ * windows (drawn on the tick), a frame that could not be shown yet, and
+ * OMACVM_GL_PRESENT_ON_TICK. After a second without any of these the
+ * listeners tick every 500 ms; the next one brings the display's rate back
+ * at once (re-arming the timer). A blinking cursor or a clock on the main
+ * output keeps the slow tick. OMACVM_IDLE_REFRESH=0 keeps the display's
+ * rate. Only in GL mode: other devices may need the tick to see changes.
+ * All of it with the BQL.
+ */
+#define COCOA_REFRESH_SLOW_MS  500
+#define COCOA_REFRESH_QUIET_MS 1000
+static uint64_t cocoa_refresh_fast[OMACVM_MAX_OUTPUTS];   /* 0: QEMU's default */
+static bool cocoa_refresh_slow;
+static bool cocoa_refresh_busy;           /* an update since the last tick */
+static int64_t cocoa_refresh_busy_ms;
+
+static bool cocoa_refresh_idle_enabled(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *e = getenv("OMACVM_IDLE_REFRESH");
+        on = display_opengl && !(e && !strcmp(e, "0"));
+        info_report("cocoa: refresh tick %s", on
+                    ? "every 500 ms while nothing changes on screen"
+                    : "at the display's rate (OMACVM_IDLE_REFRESH=0)");
+    }
+    return on;
+}
+
+static uint64_t cocoa_refresh_interval(int output)
+{
+    uint64_t ms = cocoa_refresh_fast[output];
+
+    if (cocoa_refresh_slow) {
+        ms = MAX(ms ? ms : GUI_REFRESH_INTERVAL_DEFAULT, COCOA_REFRESH_SLOW_MS);
+    }
+    return ms;
+}
+
+static void cocoa_refresh_apply(void)
+{
+    for (int i = 0; i < omacvm_outputs; i++) {
+        DisplayChangeListener *l = i ? &omacvm_heads[i].dcl : &dcl;
+
+        if (l->ds) {
+            qemu_console_listener_set_refresh(l, cocoa_refresh_interval(i));
+        }
+    }
+}
+
+/* The listener's rate while the guest draws: the display's refresh. */
+static void cocoa_refresh_set(DisplayChangeListener *l, int output, uint64_t ms)
+{
+    cocoa_refresh_fast[output] = ms;
+    qemu_console_listener_set_refresh(l, cocoa_refresh_interval(output));
+}
+
+/* A display update: tick at the display's rate again. */
+static void cocoa_refresh_activity(void)
+{
+    cocoa_refresh_busy = true;
+    if (cocoa_refresh_slow) {
+        cocoa_refresh_slow = false;
+        cocoa_refresh_apply();
+    }
+}
+
+/*
+ * Every tick of the main listener (inside gui_update). pending: the main
+ * window has a frame it has not shown yet (this tick tries again).
+ */
+static void cocoa_refresh_tick(bool pending)
+{
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+
+    if (!cocoa_refresh_idle_enabled()) {
+        return;
+    }
+    if (pending) {
+        cocoa_refresh_activity();
+    }
+    if (cocoa_refresh_busy) {
+        cocoa_refresh_busy = false;
+        cocoa_refresh_busy_ms = now;
+    } else if (!cocoa_refresh_slow &&
+               now - cocoa_refresh_busy_ms >= COCOA_REFRESH_QUIET_MS) {
+        cocoa_refresh_slow = true;
+        cocoa_refresh_apply();
+    }
+}
+

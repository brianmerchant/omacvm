 #endif
 #endif
 
+/* OmacVM: counts command buffers; a Venus image shown by copy is read at most once per buffer */
+static uint64_t vrend_submit_serial = 1;
+
 /* Called by virgl_renderer_submit_cmd(2) around a context's command buffer. */
 void vrend_renderer_submit_begin(void)
 {
+   vrend_submit_serial++;
 #ifdef __APPLE__
    atomic_fetch_add_explicit(&render_submits, 1, memory_order_relaxed);
 #endif
@@ -5859,6 +5863,50 @@ static void vrend_draw_bind_vertex_binding(struct vrend_context *ctx,
    }
 }
 
+#ifdef ENABLE_METAL
+/*
+ * OmacVM: copy a Venus image (Metal heap) into the GL texture that stands in for
+ * it. Called when a draw samples it; leaves the GL state as it found it.
+ */
+static void vrend_resource_heap_refresh(struct vrend_resource *res)
+{
+   if (res->heap_serial == vrend_submit_serial)
+      return;
+   res->heap_serial = vrend_submit_serial;
+
+   const void *data = virgl_metal_heap_reader_read(res->heap_reader);
+   if (!data)
+      return;
+
+   const enum virgl_formats format = res->base.format;
+   GLint bound = 0, unpack_buffer = 0, row_length = 0, alignment = 4, skip_rows = 0, skip_pixels = 0;
+   glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+   glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buffer);
+   glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+   glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+   glGetIntegerv(GL_UNPACK_SKIP_ROWS, &skip_rows);
+   glGetIntegerv(GL_UNPACK_SKIP_PIXELS, &skip_pixels);
+
+   if (unpack_buffer)
+      glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+   glPixelStorei(GL_UNPACK_ROW_LENGTH, res->heap_stride / util_format_get_blocksize(format));
+   glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+   glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+   glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+   glBindTexture(GL_TEXTURE_2D, res->gl_id);
+   glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, res->base.width0, res->base.height0,
+                   tex_conv_table[format].glformat, tex_conv_table[format].gltype, data);
+   glBindTexture(GL_TEXTURE_2D, bound);
+   glPixelStorei(GL_UNPACK_ROW_LENGTH, row_length);
+   glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+   glPixelStorei(GL_UNPACK_SKIP_ROWS, skip_rows);
+   glPixelStorei(GL_UNPACK_SKIP_PIXELS, skip_pixels);
+   if (unpack_buffer)
+      glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack_buffer);
+}
+
+#endif

+/* OmacVM: reads part of a Metal heap from the CPU (a Venus image that macOS
+ * OpenGL cannot import). A private heap is copied into a shared buffer by the
+ * GPU first. */
+struct virgl_metal_heap_reader;
+
+struct virgl_metal_heap_reader *
+virgl_metal_heap_reader_create(MTLHeap_id heap, uint64_t offset, uint64_t length,
+                               const char **why);
+
+const void *virgl_metal_heap_reader_read(struct virgl_metal_heap_reader *reader);
+
+bool virgl_metal_heap_reader_copies(const struct virgl_metal_heap_reader *reader);
+
+void virgl_metal_heap_reader_destroy(struct virgl_metal_heap_reader *reader);
+
 #endif
diff --git a/src/vrend/vrend_metal.m b/src/vrend/vrend_metal.m
index 7b66be0..a95693f 100644
--- a/src/vrend/vrend_metal.m
+++ b/src/vrend/vrend_metal.m
@@ -10,6 +10,7 @@
 #include "pipe/p_state.h"
 #include "util/u_math.h"
 #include <Metal/Metal.h>
+#include <stdlib.h>
 
 struct metal_format_conversion {
    uint32_t virgl_format;
@@ -200,3 +201,107 @@ void virgl_metal_release_texture(MTLTexture_id tex)
 
    [mtl_texture release];
 }
+
+struct virgl_metal_heap_reader {
+   id<MTLBuffer> buffer;        /* aliases the heap from an aligned offset */
+   id<MTLBuffer> staging;       /* shared copy, only for a private heap */
+   id<MTLCommandQueue> queue;
+   NSUInteger delta;            /* asked offset - aligned offset */
+   NSUInteger length;
+};
+
+struct virgl_metal_heap_reader *
+virgl_metal_heap_reader_create(MTLHeap_id heap, uint64_t offset, uint64_t length,
+                               const char **why)
+{
+   id<MTLHeap> mtl_heap = (id<MTLHeap>)heap;
+   id<MTLDevice> mtl_device = mtl_heap.device;
+
+   if (!length) {
+      *why = "nothing to read";
+      return NULL;
+   }
+   if (mtl_heap.type != MTLHeapTypePlacement) {
+      *why = "the Metal heap is not a placement heap";
+      return NULL;
+   }
+
+   MTLSizeAndAlign sa = [mtl_device heapBufferSizeAndAlignWithLength:length
+                                                             options:mtl_heap.resourceOptions];
+   NSUInteger align = sa.align ? sa.align : 1;
+   NSUInteger aligned = (NSUInteger)offset - (NSUInteger)offset % align;
+   NSUInteger delta = (NSUInteger)offset - aligned;
+   NSUInteger heap_size = mtl_heap.size;
+
+   /* the guest gives offset and length: never past the heap */
+   if (offset > heap_size || length > heap_size - offset) {
+      *why = "the image lies past the end of its memory";
+      return NULL;
+   }
+
+   struct virgl_metal_heap_reader *reader = calloc(1, sizeof(*reader));
+   if (!reader) {
+      *why = "out of memory";
+      return NULL;
+   }
+   reader->delta = delta;
+   reader->length = length;
+   reader->buffer = [mtl_heap newBufferWithLength:delta + length
+                                          options:mtl_heap.resourceOptions
+                                           offset:aligned];
+   if (!reader->buffer) {
+      free(reader);
+      *why = "Metal made no buffer over the heap";
+      return NULL;
+   }
+
+   if (mtl_heap.storageMode == MTLStorageModePrivate || !reader->buffer.contents) {
+      reader->staging = [mtl_device newBufferWithLength:length
+                                                options:MTLResourceStorageModeShared |
+                                                        MTLResourceCPUCacheModeDefaultCache];
+      reader->queue = [mtl_device newCommandQueue];
+      if (!reader->staging || !reader->queue) {
+         virgl_metal_heap_reader_destroy(reader);
+         *why = "Metal made no copy buffer";
+         return NULL;
+      }
+   }
+   return reader;
+}
+
+bool virgl_metal_heap_reader_copies(const struct virgl_metal_heap_reader *reader)
+{
+   return reader->staging != nil;
+}
+
+const void *virgl_metal_heap_reader_read(struct virgl_metal_heap_reader *reader)
+{
+   if (!reader->staging)
+      return (const char *)reader->buffer.contents + reader->delta;
+
+   @autoreleasepool {
+      id<MTLCommandBuffer> cmd = [reader->queue commandBuffer];
+      id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+      [blit copyFromBuffer:reader->buffer
+              sourceOffset:reader->delta
+                  toBuffer:reader->staging
+         destinationOffset:0
+                      size:reader->length];
+      [blit endEncoding];
+      [cmd commit];
+      [cmd waitUntilCompleted];
+      if (cmd.status != MTLCommandBufferStatusCompleted)
+         return NULL;
+   }
+   return reader->staging.contents;
+}
+
+void virgl_metal_heap_reader_destroy(struct virgl_metal_heap_reader *reader)
+{
+   if (!reader)
+      return;
+   [reader->buffer release];
+   [reader->staging release];
+   [reader->queue release];
+   free(reader);
+}
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index c50615d..39dabb8 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c

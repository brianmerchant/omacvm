+#ifdef ENABLE_METAL
+/*
+ * OmacVM: macOS OpenGL (CGL, no EGL) cannot import another API's memory, so a
+ * dma-buf the compositor imports (a Vulkan window: Venus memory, a Metal heap)
+ * used to fail here with EINVAL, and that error ended the compositor's whole
+ * context (black desktop for good). Now the resource gets a plain GL texture:
+ * filled from the Metal heap when a draw samples it, or left blank when the
+ * memory cannot be read. Either way the context goes on.
+ */
+static int
+vrend_pipe_resource_set_type_by_copy(struct vrend_context *ctx,
+                                     struct virgl_resource *res,
+                                     struct vrend_resource *gr,
+                                     const struct vrend_renderer_resource_create_args *create_args,
+                                     const struct vrend_renderer_resource_set_type_args *args)
+{
+   static bool told_copy, told_blank;
+   const char *why = "its memory is not a Metal heap";
+   int ret;
+
+   if (!vrend_resource_charge(gr, create_args)) {
+      FREE(gr);
+      return ENOMEM;
+   }
+   ret = vrend_resource_alloc_texture(gr, args->format, NULL);
+   if (ret) {
+      vrend_resource_uncharge(gr);
+      FREE(gr);
+      return ret;
+   }
+
+   if (res->fd_type == VIRGL_RESOURCE_METAL_HEAP && res->metal_heap) {
+      const uint64_t bpp = util_format_get_blocksize(args->format);
+      const uint64_t row = (uint64_t)args->width * bpp;
+      const uint64_t stride = args->plane_strides[0];
+
+      if (args->plane_count != 1)
+         why = "it has more than one plane";
+      else if (gr->target != GL_TEXTURE_2D || util_format_get_blockwidth(args->format) != 1 ||
+               util_format_get_blockheight(args->format) != 1)
+         why = "its format cannot be copied";
+      else if (!bpp || stride < row || stride % bpp)
+         why = "its row stride does not fit its width";
+      else if (!args->height)
+         why = "it has no rows";
+      else {
+         const uint64_t length = stride * (args->height - 1) + row;
+         gr->heap_reader = virgl_metal_heap_reader_create(res->metal_heap, args->plane_offsets[0],
+                                                          length, &why);
+         gr->heap_stride = (uint32_t)stride;
+         /* the copy buffer of a private heap is host memory too: it counts */
+         if (gr->heap_reader && virgl_metal_heap_reader_copies(gr->heap_reader)) {
+            if (virgl_gpu_budget_charge(length, false)) {
+               virgl_metal_heap_reader_destroy(gr->heap_reader);
+               gr->heap_reader = NULL;
+               why = "its copy buffer is past the guest GPU memory budget";
+            } else {
+               gr->budget_bytes += length;
+            }
+         }
+      }
+   }
+
+   if (gr->heap_reader) {
+      if (!told_copy) {
+         told_copy = true;
+         virgl_info("context %d (%s) shows a Vulkan image by %s copy: macOS OpenGL cannot "
+                    "share Venus memory\n", ctx->ctx_id, ctx->debug_name,
+                    virgl_metal_heap_reader_copies(gr->heap_reader) ? "GPU+CPU" : "CPU");
+      }
+   } else if (!told_blank) {
+      told_blank = true;
+      virgl_warn("context %d (%s): resource %u cannot be shown (%s): it stays blank, "
+                 "the context goes on\n", ctx->ctx_id, ctx->debug_name, res->res_id, why);
+   }
+
+   res->pipe_resource = &gr->base;
+   vrend_ctx_resource_insert(ctx->res_hash, res->res_id, gr);
+   return 0;
+}
+#endif
+
 int
 vrend_renderer_pipe_resource_set_type(struct vrend_context *ctx,
                                       uint32_t res_id,
@@ -15550,6 +15689,11 @@ vrend_renderer_pipe_resource_set_type(struct vrend_context *ctx,
       if (!gr)
          return ENOMEM;
 
+#ifdef ENABLE_METAL
+      if (!egl)
+         return vrend_pipe_resource_set_type_by_copy(ctx, res, gr, &create_args, args);
+#endif
+
 #ifdef HAVE_EPOXY_EGL_H
       if (egl) {
 #ifdef ENABLE_GBM

+
+/* Without ARB_framebuffer_no_attachments (macOS) the host GL refuses to draw
+ * or clear into a framebuffer that has no attachments (GL error, which stops
+ * the guest context). The guest has such a framebuffer when all its draw
+ * buffers are GL_NONE: legal, nothing is written, but occlusion queries still
+ * count the fragments. The stand-in is a depth renderbuffer (Apple's GL calls
+ * a framebuffer whose only colour attachment no draw buffer selects
+ * "unsupported"). Draws make it as large as the first viewport (the guest
+ * does not send its framebuffer size without VIRGL_CAP_FB_NO_ATTACH), at most
+ * VREND_FB_PLACEHOLDER_MAX square (128 MiB) and the host's renderbuffer limit.
+ * It is kept while the guest switches framebuffers (a guest that uses it every
+ * frame does not make a new one every frame) and freed after
+ * VREND_FB_PLACEHOLDER_IDLE framebuffer changes or VREND_FB_PLACEHOLDER_IDLE_DRAWS
+ * draws without it, or with the sub context. While it is attached the depth
+ * test stays off, as GL does without a depth buffer (vrend_hw_emit_dsa). No
+ * stencil: the stencil test passes. */
+#define VREND_FB_PLACEHOLDER_MAX 8192
+#define VREND_FB_PLACEHOLDER_IDLE 64
+#define VREND_FB_PLACEHOLDER_IDLE_DRAWS 4096
+
+static void vrend_hw_size_fb_placeholder(struct vrend_sub_context *sub_ctx)
+{
+   const struct vrend_viewport *vp = &sub_ctx->vps[0];
+   if (!vrend_state.max_renderbuffer_size)
+      glGetIntegerv(GL_MAX_RENDERBUFFER_SIZE, &vrend_state.max_renderbuffer_size);
+   int64_t max = CLAMP((int64_t)vrend_state.max_renderbuffer_size, 1, VREND_FB_PLACEHOLDER_MAX);
+   int64_t y = sub_ctx->viewport_is_negative ? (int64_t)vp->cur_y - vp->height : vp->cur_y;
+   int64_t width = CLAMP((int64_t)vp->cur_x + vp->width, 1, max);
+   int64_t height = CLAMP(y + vp->height, 1, max);
+
+   if (width <= sub_ctx->fb_placeholder_width && height <= sub_ctx->fb_placeholder_height)
+      return;
+
+   sub_ctx->fb_placeholder_width = MAX2(sub_ctx->fb_placeholder_width, (GLsizei)width);
+   sub_ctx->fb_placeholder_height = MAX2(sub_ctx->fb_placeholder_height, (GLsizei)height);
+   glBindRenderbuffer(GL_RENDERBUFFER, sub_ctx->fb_placeholder_rb);
+   glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT16,
+                         sub_ctx->fb_placeholder_width, sub_ctx->fb_placeholder_height);
+   glBindRenderbuffer(GL_RENDERBUFFER, 0);
+}
+
+static void vrend_hw_free_fb_placeholder(struct vrend_sub_context *sub_ctx)
+{
+   if (sub_ctx->fb_placeholder_rb)
+      glDeleteRenderbuffers(1, &sub_ctx->fb_placeholder_rb);
+   sub_ctx->fb_placeholder_rb = 0;
+   sub_ctx->fb_placeholder_width = 0;
+   sub_ctx->fb_placeholder_height = 0;
+}
+
+static void vrend_hw_set_fb_placeholder(struct vrend_sub_context *sub_ctx)
+{
+   bool needed = !sub_ctx->nr_cbufs && !sub_ctx->zsurf && !has_feature(feat_fb_no_attach);
+
+   if (needed) {
+      sub_ctx->fb_placeholder_idle = 0;
+      sub_ctx->fb_placeholder_idle_draws = 0;
+   } else if (sub_ctx->fb_placeholder_rb && !sub_ctx->fb_placeholder_attached &&
+            ++sub_ctx->fb_placeholder_idle > VREND_FB_PLACEHOLDER_IDLE)
+      vrend_hw_free_fb_placeholder(sub_ctx);
+
+   if (needed == sub_ctx->fb_placeholder_attached)
+      return;
+
+   sub_ctx->fb_placeholder_attached = needed;
+   if (needed) {
+      if (!sub_ctx->fb_placeholder_rb) {
+         /* 1x1 for now (a clear needs a complete framebuffer); the draws size
+          * it, the viewport here may still be the last framebuffer's */
+         glGenRenderbuffers(1, &sub_ctx->fb_placeholder_rb);
+         glBindRenderbuffer(GL_RENDERBUFFER, sub_ctx->fb_placeholder_rb);
+         glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT16, 1, 1);
+         glBindRenderbuffer(GL_RENDERBUFFER, 0);
+         sub_ctx->fb_placeholder_width = 1;
+         sub_ctx->fb_placeholder_height = 1;
+      }
+      glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER,
+                                sub_ctx->fb_placeholder_rb);
+   } else {
+      /* unless the guest's depth buffer has taken its place already */
+      if (!sub_ctx->zsurf ||
+          !util_format_has_depth(util_format_description(sub_ctx->zsurf->format)))
+         glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, 0);
    }
+   /* the guest's depth test is off while the stand-in is there, back after */
+   vrend_hw_emit_dsa(sub_ctx);
 }
 

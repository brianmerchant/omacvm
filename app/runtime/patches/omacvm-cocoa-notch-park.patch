+/* NOTCH's top row above an output's middle, from the layout the guest reported. */
+static bool omacvm_notch_park_target(int output, double *nx, double *ny)
+{
+    const OmacVMBox *s, *n = &omacvm_guest_notch;
+    const OmacVMBox *a = &omacvm_guest_bounds;
+
+    if (!omacvm_guest_known || output < 0 || output >= OMACVM_MAX_OUTPUTS) {
+        return false;
+    }
+    s = &omacvm_guest_box[output];
+    return omacvm_park_place((OmacVMParkBox){ s->x, s->y, s->w, s->h },
+                             (OmacVMParkBox){ n->x, n->y, n->w, n->h },
+                             (OmacVMParkBox){ a->x, a->y, a->w, a->h }, nx, ny);
+}
+
 static int omacvm_active_outputs(void)
 {
     return omacvm_mac_count;

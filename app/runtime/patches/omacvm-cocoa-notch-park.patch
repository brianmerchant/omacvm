+/*
+ * OmacVM: up into Omanotch's strip in full screen below a notch, the guest's
+ * pointer goes into its hidden NOTCH output in the same moment (one cursor:
+ * the Mac's shows on the strip at once; ui/omacvm-notch-park.h says why).
+ * The next motion over the VM brings it back. The main view and the views
+ * of the other outputs (the MacBook's display can be one of those when an
+ * external display has the main window).
+ */
+- (void) omacvmParkInNotch:(NSEvent *)event view:(NSView *)view output:(int)output
+{
+    NSPoint p = [view convertPoint:[event locationInWindow] fromView:nil];
+    NSSize size = [view bounds].size;
+    NSWindow *w = [view window];
+    OmacVMParkIn in = {
+        .absolute = isAbsoluteEnabled,
+        .grabbed = isMouseGrabbed,
+        .full_screen = w && ([w styleMask] & NSWindowStyleMaskFullScreen),
+        .notch_inset = w ? [[w screen] safeAreaInsets].top : 0,
+        .exit_y = p.y,
+        .view_h = size.height,
+    };
+    double nx, ny;
+
+    if (!omacvm_park_wanted(&in) || !omacvm_notch_park_target(output, &nx, &ny)) {
+        return;
+    }
+    with_bql(^{
+        qemu_input_queue_abs(dcl.con, INPUT_AXIS_X, lround(nx * INPUT_EVENT_ABS_MAX),
+                             0, INPUT_EVENT_ABS_MAX);
+        qemu_input_queue_abs(dcl.con, INPUT_AXIS_Y, lround(ny * INPUT_EVENT_ABS_MAX),
+                             0, INPUT_EVENT_ABS_MAX);
+        qemu_input_event_sync();
+    });
+    if (omacvm_pointer_debug) {
+        fprintf(stderr, "omacvm-pointer: up into the strip (output %d): guest pointer to NOTCH (%.4f, %.4f)\n",
+                output, nx, ny);
+    }
+}
+
 /* OmacVM: a drag that ended outside every window of ours lets go of the pointer. */

 {
     QemuInputHandlerState *s;
 
     trace_input_event_sync();
+    qatomic_set(&input_last_event_ns, qemu_clock_get_ns(QEMU_CLOCK_REALTIME));
 
     QTAILQ_FOREACH(s, &handlers, node) {
         if (!s->events) {

--- /dev/null
+++ b/src/virgl_gpu_budget.h
@@ -0,0 +1,36 @@
+/*
+ * OmacVM: the guest GPU memory budget (OMACVM_GPU_MEMORY_MB, default a quarter of the
+ * Mac's memory), shared by vrend resources and Venus device memory. Charges and refunds
+ * are atomic: Venus allocates on its ring threads. Defined in vrend/vrend_renderer.c.
+ */
+#ifndef VIRGL_GPU_BUDGET_H
+#define VIRGL_GPU_BUDGET_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* reads the budget once; later calls do nothing */
+void virgl_gpu_budget_init(void);
+/* 0 when the bytes were charged, else the number of this refusal (1, 2, 3 ...);
+ * display: screens and cursors may use the reserve past the budget */
+uint64_t virgl_gpu_budget_charge(uint64_t bytes, bool display);
+void virgl_gpu_budget_uncharge(uint64_t bytes);
+uint64_t virgl_gpu_budget_in_use(void);
+uint64_t virgl_gpu_budget_limit(void);
+
+/*
+ * A charge that goes with a piece of storage (Venus device memory, a shm blob): every
+ * object that keeps the storage alive holds a reference (the VkDeviceMemory, memory
+ * imported from it, the Venus context's resource and the virgl_resource the guest's
+ * blob is). The bytes come back when the last one is gone. Any thread.
+ */
+struct virgl_gpu_charge;
+
+/* NULL when the budget refuses the bytes; *refusal is then the number of this refusal
+ * (0 when only the small allocation failed) */
+struct virgl_gpu_charge *virgl_gpu_charge_create(uint64_t bytes, uint64_t *refusal);
+/* NULL stays NULL */
+struct virgl_gpu_charge *virgl_gpu_charge_ref(struct virgl_gpu_charge *charge);
+void virgl_gpu_charge_unref(struct virgl_gpu_charge *charge);
+
+#endif

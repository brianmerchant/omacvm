+struct virgl_gpu_charge *
+vkr_memory_charge_create(uint64_t bytes, const char *what)
+{
+   /* whole pages: many tiny allocations count too */
+   const uint64_t page = getpagesize();
+   bytes = bytes > UINT64_MAX - page ? UINT64_MAX : align64(bytes, page);
+
+   uint64_t n;
+   struct virgl_gpu_charge *charge = virgl_gpu_charge_create(bytes, &n);
+   /* the 1st, 2nd, 4th, 8th ... refusal: a guest in a loop cannot flood the log */
+   if (!charge && n && !(n & (n - 1)))
+      vkr_log("guest GPU memory budget of %" PRIu64 " MB reached: refused %" PRIu64
+              " KB of %s with %" PRIu64 " MB in use (%" PRIu64 " refused so far)",
+              virgl_gpu_budget_limit() >> 20, bytes >> 10, what,
+              virgl_gpu_budget_in_use() >> 20, n);
+   return charge;
+}

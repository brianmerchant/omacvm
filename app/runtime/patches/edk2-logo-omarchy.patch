diff --git a/MdeModulePkg/Logo/Logo.c b/MdeModulePkg/Logo/Logo.c
index 8ab874d2dadb87afb908d93ae8fbd53c32c33427..e240c6c4b56546abb12b10fbd3ecd3af991c4779 100644
--- a/MdeModulePkg/Logo/Logo.c
+++ b/MdeModulePkg/Logo/Logo.c
@@ -12,8 +12,15 @@ SPDX-License-Identifier: BSD-2-Clause-Patent
 #include <Protocol/PlatformLogo.h>
 #include <Protocol/HiiPackageList.h>
 #include <Library/UefiBootServicesTableLib.h>
+#include <Library/MemoryAllocationLib.h>
 #include <Library/DebugLib.h>
 
+//
+// OmacVM: the logo is Omarchy's wordmark, 81 x 19 square cells.
+//
+#define LOGO_COLS  81
+#define LOGO_ROWS  19
+
 typedef struct {
   EFI_IMAGE_ID                             ImageId;
   EDKII_PLATFORM_LOGO_DISPLAY_ATTRIBUTE    Attribute;
@@ -45,6 +52,57 @@ LOGO_ENTRY                 mLogos[] = {
   @retval EFI_SUCCESS      The image was fetched successfully.
   @retval EFI_NOT_FOUND    The specified image could not be found.
 **/
+/**
+  OmacVM: scale the logo down to fit the screen, a whole number of pixels a
+  cell (the biggest that fits), so its edges stay sharp. BootLogoLib skips a
+  logo bigger than the screen: a small window after a reboot showed none.
+
+  @param Image  The logo; its bitmap is replaced when it is made smaller.
+**/
+STATIC
+VOID
+FitLogo (
+  IN OUT EFI_IMAGE_INPUT  *Image
+  )
+{
+  EFI_GRAPHICS_OUTPUT_PROTOCOL   *Gop;
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL  *Small;
+  UINTN                          Cell;
+  UINTN                          NewCell;
+  UINTN                          X;
+  UINTN                          Y;
+
+  if (EFI_ERROR (gBS->HandleProtocol (gST->ConsoleOutHandle, &gEfiGraphicsOutputProtocolGuid, (VOID **)&Gop)) ||
+      (Gop->Mode == NULL) || (Gop->Mode->Info == NULL) ||
+      ((Image->Width % LOGO_COLS) != 0) || (Image->Height != Image->Width / LOGO_COLS * LOGO_ROWS))
+  {
+    return;
+  }
+
+  Cell    = Image->Width / LOGO_COLS;
+  NewCell = MIN (Gop->Mode->Info->HorizontalResolution / LOGO_COLS, Gop->Mode->Info->VerticalResolution / LOGO_ROWS);
+  if ((NewCell >= Cell) || (NewCell == 0)) {
+    return;
+  }
+
+  Small = AllocatePool (LOGO_COLS * NewCell * LOGO_ROWS * NewCell * sizeof (*Small));
+  if (Small == NULL) {
+    return;
+  }
+
+  for (Y = 0; Y < LOGO_ROWS * NewCell; Y++) {
+    for (X = 0; X < LOGO_COLS * NewCell; X++) {
+      Small[Y * LOGO_COLS * NewCell + X] =
+        Image->Bitmap[((Y / NewCell) * Cell + Cell / 2) * Image->Width + (X / NewCell) * Cell + Cell / 2];
+    }
+  }
+
+  FreePool (Image->Bitmap);
+  Image->Bitmap = Small;
+  Image->Width  = (UINT16)(LOGO_COLS * NewCell);
+  Image->Height = (UINT16)(LOGO_ROWS * NewCell);
+}
+
 EFI_STATUS
 EFIAPI
 GetImage (
@@ -56,7 +114,8 @@ GetImage (
   OUT INTN                                   *OffsetY
   )
 {
-  UINT32  Current;
+  UINT32      Current;
+  EFI_STATUS  Status;
 
   if ((Instance == NULL) || (Image == NULL) ||
       (Attribute == NULL) || (OffsetX == NULL) || (OffsetY == NULL))
@@ -73,7 +132,12 @@ GetImage (
   *Attribute = mLogos[Current].Attribute;
   *OffsetX   = mLogos[Current].OffsetX;
   *OffsetY   = mLogos[Current].OffsetY;
-  return mHiiImageEx->GetImageEx (mHiiImageEx, mHiiHandle, mLogos[Current].ImageId, Image);
+  Status     = mHiiImageEx->GetImageEx (mHiiImageEx, mHiiHandle, mLogos[Current].ImageId, Image);
+  if (!EFI_ERROR (Status)) {
+    FitLogo (Image);
+  }
+
+  return Status;
 }
 

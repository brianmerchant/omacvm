+
+/*
+ * OmacVM: guest GPU memory follows the Mac's memory (virgl-darwin-memory-pressure.patch).
+ * The budget above is only a guard against a runaway guest. Below it a resource is
+ * refused only when macOS itself is short of memory:
+ * - A dispatch source follows macOS's memory pressure. Its handler runs on a
+ *   libdispatch thread and only stores the level; the renderer thread acts on it
+ *   in vrend_memory_tick (from virgl_renderer_poll), which also reads the level
+ *   itself once a second (macOS notifies only some processes of a warning, one at
+ *   a time): it logs each change and, when
+ *   the pressure rises, lets Apple's GL free what it still holds for deleted
+ *   textures and buffers (glFinish).
+ * - A new big resource (VREND_MEMORY_BIG or more; never a screen or cursor) is
+ *   checked against the pressure macOS has right now: refused at "critical", and
+ *   at "warn" only when it is bigger than all the free, inactive and purgeable
+ *   memory macOS has left (swapping more is better than a black desktop, short
+ *   of that). Before a refusal the renderer finishes its GL work and looks again
+ *   three times over 100 ms. Small resources, screens and cursors are never
+ *   refused for pressure.
+ * - OMACVM_GPU_MEMORY_STATUS names a file the app and omacvm check read: memory in
+ *   use, its peak since the VM started, the budget, the pressure, refusals and lost
+ *   GPU contexts. Written at most four times a second (on the renderer thread, by
+ *   rename), at once for a refusal or a lost context.
+ * OMACVM_GPU_MEMORY_PRESSURE=off|normal|warn|critical[:AVAILABLE_MB] fixes the
+ * level (and the available memory) instead of asking macOS: for tests.
+ */
+#define VREND_MEMORY_BIG            (16ull << 20)
+#define VREND_MEMORY_STATUS_STEP    (8ull << 20)
+#define VREND_MEMORY_STATUS_NS      250000000ull
+#define VREND_MEMORY_CHECK_NS       1000000000ull
+
+enum vrend_pressure { VREND_PRESSURE_NORMAL, VREND_PRESSURE_WARN, VREND_PRESSURE_CRITICAL };
+static const char *const vrend_pressure_names[] = { "normal", "warn", "critical" };
+
+static struct {
+   atomic_int level;            /* the dispatch handler writes these two */
+   atomic_uint events;
+   bool watching;
+   int fixed_level;             /* -1: ask macOS; -2: off (OMACVM_GPU_MEMORY_PRESSURE) */
+   uint64_t fixed_available;
+   /* the renderer thread only, from here on */
+   unsigned seen_events;
+   uint64_t checked_ns;
+   int handled_level;
+   uint64_t peak;
+   uint64_t refusals;
+   uint64_t lost;
+   char lost_last[64];
+   char lost_recent[8][64];     /* the last eight, oldest first */
+   char *status_path;
+   bool dirty;
+   uint64_t written_bytes, written_peak, written_ns;
+} vrend_memory = { .fixed_level = -1 };
+
+static uint64_t vrend_memory_now_ns(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+#ifdef __APPLE__
+static void vrend_memory_pressure_event(void *source)
+{
+   unsigned long data = dispatch_source_get_data((dispatch_source_t)source);
+   int level = data & DISPATCH_MEMORYPRESSURE_CRITICAL ? VREND_PRESSURE_CRITICAL :
+               data & DISPATCH_MEMORYPRESSURE_WARN ? VREND_PRESSURE_WARN : VREND_PRESSURE_NORMAL;
+   atomic_store(&vrend_memory.level, level);
+   atomic_fetch_add(&vrend_memory.events, 1);
+}
+#endif
+
+/* macOS's pressure level right now (kern.memorystatus_vm_pressure_level: 1, 2 or 4). */
+static int vrend_memory_pressure_now(void)
+{
+   if (vrend_memory.fixed_level != -1)
+      return MAX2(vrend_memory.fixed_level, VREND_PRESSURE_NORMAL);
+#ifdef __APPLE__
+   int value = 0;
+   size_t len = sizeof(value);
+   if (!sysctlbyname("kern.memorystatus_vm_pressure_level", &value, &len, NULL, 0))
+      return value & 4 ? VREND_PRESSURE_CRITICAL : value & 2 ? VREND_PRESSURE_WARN : VREND_PRESSURE_NORMAL;
+#endif
+   return atomic_load(&vrend_memory.level);
+}
+
+/* Free, inactive and purgeable memory: what macOS can give without swapping much. */
+static uint64_t vrend_memory_available(void)
+{
+   if (vrend_memory.fixed_level != -1 && vrend_memory.fixed_available)
+      return vrend_memory.fixed_available;
+#ifdef __APPLE__
+   static mach_port_t host;
+   vm_statistics64_data_t vm;
+   mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+   if (!host)
+      host = mach_host_self();
+   if (host_statistics64(host, HOST_VM_INFO64, (host_info64_t)&vm, &count) == KERN_SUCCESS)
+      return ((uint64_t)vm.free_count + vm.inactive_count + vm.purgeable_count) * vm_kernel_page_size;
+#endif
+   return UINT64_MAX;
+}
+
+static void vrend_memory_init(void)
+{
+   const char *path = getenv("OMACVM_GPU_MEMORY_STATUS");
+   const char *fixed = getenv("OMACVM_GPU_MEMORY_PRESSURE");
+
+   free(vrend_memory.status_path);
+   vrend_memory.status_path = path && *path ? strdup(path) : NULL;
+   vrend_memory.fixed_level = -1;
+   vrend_memory.fixed_available = 0;
+   if (fixed && *fixed) {
+      const char *colon = strchr(fixed, ':');
+      size_t n = colon ? (size_t)(colon - fixed) : strlen(fixed);
+      for (int i = 0; i < 3; i++)
+         if (n == strlen(vrend_pressure_names[i]) && !strncmp(fixed, vrend_pressure_names[i], n))
+            vrend_memory.fixed_level = i;
+      if (n == 3 && !strncmp(fixed, "off", 3))
+         vrend_memory.fixed_level = -2;
+      if (colon)
+         vrend_memory.fixed_available = strtoull(colon + 1, NULL, 10) << 20;
+      if (vrend_memory.fixed_level == -1)
+         virgl_warn("OMACVM_GPU_MEMORY_PRESSURE=%s is not off, normal, warn or critical\n", fixed);
+   }
+   /* the peak, refusals and lost contexts count from the VM's start, across renderer resets */
+   vrend_memory.handled_level = vrend_memory_pressure_now();
+   atomic_store(&vrend_memory.level, vrend_memory.handled_level);
+#ifdef __APPLE__
+   if (!vrend_memory.watching && vrend_memory.fixed_level == -1) {
+      dispatch_source_t source = dispatch_source_create(DISPATCH_SOURCE_TYPE_MEMORYPRESSURE, 0,
+                                                        DISPATCH_MEMORYPRESSURE_NORMAL |
+                                                        DISPATCH_MEMORYPRESSURE_WARN |
+                                                        DISPATCH_MEMORYPRESSURE_CRITICAL,
+                                                        dispatch_get_global_queue(QOS_CLASS_UTILITY, 0));
+      if (source) {
+         dispatch_set_context(source, source);
+         dispatch_source_set_event_handler_f(source, vrend_memory_pressure_event);
+         dispatch_resume(source);
+         vrend_memory.watching = true;
+      } else {
+         virgl_warn("no macOS memory pressure watcher; big GPU resources are still checked when made\n");
+      }
+   }
+#endif
+   virgl_info("guest GPU memory follows the Mac's memory: pressure %s now%s\n",
+              vrend_memory.fixed_level == -2 ? "not checked" :
+              vrend_pressure_names[vrend_memory.handled_level],
+              vrend_memory.fixed_level != -1 ? " (OMACVM_GPU_MEMORY_PRESSURE)" : "");
+   vrend_memory.dirty = true;
+}
+
+/* Apple's GL keeps the storage of deleted textures and buffers until the GPU is done
+ * with them; finishing the queued work lets it go. In the middle of a guest's commands
+ * (a resource made while its context runs) the current context stays current. */
+static void vrend_memory_trim(bool own_context)
+{
+   if (own_context)
+      vrend_renderer_force_ctx_0();
+   glFlush();
+   glFinish();
+}
+
+static void vrend_memory_status_write(bool now)
+{
+   char text[1280], recent[8 * 65] = "", tmp[PATH_MAX];
+   uint64_t t = vrend_memory_now_ns();
+   int fd, len;
+
+   if (!vrend_memory.status_path) {
+      vrend_memory.dirty = false;
+      return;
+   }
+   if (!now && t - vrend_memory.written_ns < VREND_MEMORY_STATUS_NS)
+      return;
+   for (int i = 0; i < 8; i++) {
+      if (!vrend_memory.lost_recent[i][0])
+         continue;
+      if (recent[0])
+         strcat(recent, ",");
+      strcat(recent, vrend_memory.lost_recent[i]);
+   }
+   len = snprintf(text, sizeof(text),
+                  "in_use_mb=%llu\npeak_mb=%llu\nbudget_mb=%llu\npressure=%s\nrefused=%llu\n"
+                  "lost=%llu\nlost_last=%s\nlost_recent=%s\n",
+                  (unsigned long long)(vrend_state.resource_bytes >> 20),
+                  (unsigned long long)(vrend_memory.peak >> 20),
+                  (unsigned long long)(vrend_state.resource_budget >> 20),
+                  vrend_pressure_names[vrend_memory.handled_level],
+                  (unsigned long long)(vrend_memory.refusals + vrend_state.resource_refusals),
+                  (unsigned long long)vrend_memory.lost, vrend_memory.lost_last, recent);
+   if (snprintf(tmp, sizeof(tmp), "%s.tmp", vrend_memory.status_path) >= (int)sizeof(tmp))
+      return;
+   fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+   if (fd < 0)
+      return;
+   bool ok = write(fd, text, len) == len;
+   close(fd);
+   if (!ok || rename(tmp, vrend_memory.status_path))
+      unlink(tmp);
+   vrend_memory.dirty = false;
+   vrend_memory.written_ns = t;
+   vrend_memory.written_bytes = vrend_state.resource_bytes;
+   vrend_memory.written_peak = vrend_memory.peak;
+}
+
+static void vrend_memory_changed(void)
+{
+   uint64_t bytes = vrend_state.resource_bytes;
+   if (bytes > vrend_memory.peak)
+      vrend_memory.peak = bytes;
+   if (bytes > vrend_memory.written_bytes + VREND_MEMORY_STATUS_STEP ||
+       bytes + VREND_MEMORY_STATUS_STEP < vrend_memory.written_bytes ||
+       vrend_memory.peak > vrend_memory.written_peak + VREND_MEMORY_STATUS_STEP ||
+       (!bytes && vrend_memory.written_bytes))
+      vrend_memory.dirty = true;
+}
+
+static void vrend_memory_tick(void)
+{
+   unsigned events = atomic_load(&vrend_memory.events);
+   int level = vrend_memory.handled_level;
+   uint64_t t = vrend_memory_now_ns();
+
+   if (events != vrend_memory.seen_events) {
+      vrend_memory.seen_events = events;
+      level = atomic_load(&vrend_memory.level);
+   } else if (t - vrend_memory.checked_ns >= VREND_MEMORY_CHECK_NS) {
+      /* macOS tells only some processes about a warning, one at a time (seen on a Mac
+       * mini at warn: no event for minutes), so look for ourselves once a second */
+      vrend_memory.checked_ns = t;
+      level = vrend_memory_pressure_now();
+   }
+   if (level != vrend_memory.handled_level) {
+      virgl_info("macOS memory pressure: %s (guest GPU memory in use: %llu MB)%s\n",
+                 vrend_pressure_names[level],
+                 (unsigned long long)(vrend_state.resource_bytes >> 20),
+                 level > vrend_memory.handled_level ? "; freeing what the GL still holds" : "");
+      if (level > vrend_memory.handled_level)
+         vrend_memory_trim(true);
+      vrend_memory.handled_level = level;
+      vrend_memory.dirty = true;
+   }
+   if (vrend_memory.dirty)
+      vrend_memory_status_write(false);
+}
+
+/* Is there room on the Mac for SIZE more bytes? */
+static bool vrend_memory_room(uint64_t size, int *level, uint64_t *available)
+{
+   *level = vrend_memory_pressure_now();
+   *available = *level == VREND_PRESSURE_NORMAL ? UINT64_MAX : vrend_memory_available();
+   if (*level == VREND_PRESSURE_CRITICAL)
+      return false;
+   return *available >= size;
+}
+
+static bool vrend_memory_allows(uint64_t size, const struct vrend_renderer_resource_create_args *args)
+{
+   int level;
+   uint64_t available;
+
+   if (size < VREND_MEMORY_BIG || (args->bind & VREND_RESOURCE_DISPLAY_BINDS) ||
+       vrend_memory.fixed_level == -2 || vrend_memory_room(size, &level, &available))
+      return true;
+   for (int i = 0; i < 3; i++) {
+      vrend_memory_trim(false);
+      if (i)
+         usleep(50000);
+      if (vrend_memory_room(size, &level, &available)) {
+         virgl_info("macOS memory pressure %s: a %ux%u resource of %llu MB fit after freeing\n",
+                    vrend_pressure_names[level], args->width, args->height,
+                    (unsigned long long)(size >> 20));
+         return true;
+      }
+   }
+   /* logged at the 1st, 2nd, 4th, 8th ... refusal */
+   uint64_t n = ++vrend_memory.refusals;
+   if (!(n & (n - 1)))
+      virgl_warn("macOS is short of memory (pressure %s, %llu MB free or inactive): refused a "
+                 "%ux%ux%u resource of %llu MB with %llu MB in use (%llu refused so far)\n",
+                 vrend_pressure_names[level],
+                 (unsigned long long)(available == UINT64_MAX ? 0 : available >> 20),
+                 args->width, args->height, MAX2(args->depth, args->array_size),
+                 (unsigned long long)(size >> 20),
+                 (unsigned long long)(vrend_state.resource_bytes >> 20), (unsigned long long)n);
+   vrend_memory.handled_level = MAX2(vrend_memory.handled_level, level);
+   vrend_memory_status_write(true);
+   return false;
+}
+
+/* A GPU context is lost: the app's window says so (the guest-chosen name is
+ * reduced to letters, digits and . _ -). */
+static void vrend_memory_status_lost(const char *name)
+{
+   size_t i = 0;
+   for (; name && name[i] && i < sizeof(vrend_memory.lost_last) - 1; i++) {
+      char c = name[i];
+      vrend_memory.lost_last[i] = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                                  (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-' ? c : '_';
+   }
+   vrend_memory.lost_last[i] = 0;
+   if (!i)
+      snprintf(vrend_memory.lost_last, sizeof(vrend_memory.lost_last), "unnamed");
+   memmove(vrend_memory.lost_recent[0], vrend_memory.lost_recent[1], sizeof(vrend_memory.lost_recent[0]) * 7);
+   memcpy(vrend_memory.lost_recent[7], vrend_memory.lost_last, sizeof(vrend_memory.lost_last));
+   vrend_memory.lost++;
+   vrend_memory_status_write(true);
 }
 

+      bool from_pbo = false;
+      GLint old_unpack = 0;
+      if (vrend_state.use_core_profile && !vrend_state.use_gles && !compressed && !invert &&
+          res->base.format != VIRGL_FORMAT_Z24X8_UNORM && info->box->depth == 1 &&
+          (res->target == GL_TEXTURE_2D || res->target == GL_TEXTURE_RECTANGLE) &&
+          send_size >= VREND_UPLOAD_PBO_MIN && send_size <= UINT_MAX &&
+          (need_temp || send_size <= iov[0].iov_len - info->offset) &&
+          vrend_upload_pbo_wanted()) {
+         glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &old_unpack);
+         data = vrend_upload_pbo_map(send_size);

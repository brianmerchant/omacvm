+/*
+ * OmacVM: the desktop reserve (virgl-gpu-guard-desktop-reserve.patch, rules in
+ * virgl_gpu_guard.h). The budget's last part is kept for the desktop's contexts
+ * (OMACVM_GPU_MEMORY_DESKTOP, default Hyprland, quickshell, hyprlock): apps and Venus memory
+ * stop below it. OMACVM_GPU_MEMORY_RESERVE_MB sets its size (0: none); the default is
+ * a sixteenth of the Mac's memory, 512 MB to 2 GB, at most a quarter of the budget.
+ */
+static void vrend_desktop_reserve_read(uint64_t mac)
+{
+   const char *env = getenv("OMACVM_GPU_MEMORY_RESERVE_MB");
+   const char *names = getenv("OMACVM_GPU_MEMORY_DESKTOP");
+   uint64_t budget = vrend_state.resource_budget;
+   uint64_t reserve = virgl_gpu_guard_reserve(mac, budget);
+
+   if (env && *env) {
+      char *end = NULL;
+      unsigned long long mb = strtoull(env, &end, 10);
+      if (end && !*end && mb <= UINT64_MAX >> 20)
+         reserve = budget ? (uint64_t)mb << 20 : 0;
+      else
+         virgl_warn("OMACVM_GPU_MEMORY_RESERVE_MB=%s is not a number of MB; using the default\n", env);
+   }
+   vrend_state.resource_reserve = reserve;
+   free(vrend_state.desktop_names);
+   vrend_state.desktop_names = strdup(names ? names : VIRGL_GPU_GUARD_DESKTOP_DEFAULT);
+   if (budget) {
+      uint64_t apps = virgl_gpu_guard_limit(budget, reserve, VIRGL_GPU_GUARD_APP);
+      virgl_info("guest GPU memory for apps: up to %llu MB; the last %llu MB are kept for the "
+                 "desktop (%s)\n", (unsigned long long)(apps >> 20),
+                 (unsigned long long)((budget - apps) >> 20),
+                 vrend_state.desktop_names ? vrend_state.desktop_names : "");
+   }
+}

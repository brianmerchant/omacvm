+/*
+ * OmacVM: handles of resources made for the desktop only (past the apps' share of the
+ * budget, or while macOS was short of memory: virgl-gpu-guard-desktop-reserve.patch).
+ * The first GL context that attaches one decides: the desktop's keeps it, an app's is
+ * lost. The last DESKTOP_ONLY_HANDLES are kept (the kernel attaches right after making
+ * one); an older one is simply kept by whoever takes it, still inside the budget.
+ */
+#define DESKTOP_ONLY_HANDLES 64
+static struct { uint32_t handle; int why; } desktop_only[DESKTOP_ONLY_HANDLES];
+static unsigned desktop_only_next;
+
+static void desktop_only_add(uint32_t handle, int why)
+{
+   desktop_only[desktop_only_next].handle = handle;
+   desktop_only[desktop_only_next].why = why;
+   desktop_only_next = (desktop_only_next + 1) % DESKTOP_ONLY_HANDLES;
+}
+
+/* 0 when HANDLE is not waiting for its context, else why it was made for the desktop only */
+static int desktop_only_take(uint32_t handle)
+{
+   for (unsigned i = 0; handle && i < DESKTOP_ONLY_HANDLES; i++) {
+      if (desktop_only[i].handle == handle) {
+         desktop_only[i].handle = 0;
+         return desktop_only[i].why;
+      }
+   }
+   return 0;
 }
 

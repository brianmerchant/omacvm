             uint8_t code = ICMP_UNREACH_PORT;
@@ -598,6 +601,9 @@ void sorecvfrom(struct socket *so)
 
         len = recvfrom(so->s, buff, 256, 0, (struct sockaddr *)&addr, &addrlen);
         /* XXX Check if reply is "correct"? */
+        if (len == -1 && so_would_block(errno)) {
+            return;
+        }
 
         if (len == -1 || len == 0) {
             uint8_t code = ICMP6_UNREACH_PORT;
@@ -664,7 +670,10 @@ void sorecvfrom(struct socket *so)
         DEBUG_MISC(" did recvfrom %d, errno = %d-%s", m->m_len, errno,
                    g_strerror(errno));
         if (m->m_len < 0) {    	
-            if (errno == ENOTCONN) {
+            if (so_would_block(errno)) {
+                /* Nothing to read after all: keep the socket */
+                m_free(m);
+            } else if (errno == ENOTCONN) {
                 /*
                  * UDP socket got burnt, e.g. by suspend on iOS. Tear it down
                  * and let it get re-created if the guest still needs it
@@ -764,6 +773,51 @@ void sorecvfrom(struct socket *so)
     } /* if ping packet */
 }
 
+/* The socket is non-blocking and has nothing (or no room) right now. */
+bool so_would_block(int err)
+{
+    return err == EAGAIN || err == EWOULDBLOCK || err == EINTR;
+}
+
+/*
+ * A datagram the host could not take at once: its send buffer is full, the
+ * interface queue is full (ENOBUFS), or a network filter still holds earlier
+ * data. Drop it, as a busy link would; the guest's protocols retry. Waiting
+ * instead would stop the caller's main loop and with it the whole VM.
+ * Returns true when err is such a case (counted, logged at most once a
+ * minute with the destination); false for a real error.
+ */
+bool sodrop_busy(Slirp *slirp, int err, const struct sockaddr *dst)
+{
+    char addr[INET6_ADDRSTRLEN] = "?";
+    unsigned port = 0;
+    int64_t now;
+
+    if (err != EAGAIN && err != EWOULDBLOCK && err != ENOBUFS) {
+        return false;
+    }
+    slirp->busy_drops++;
+    now = slirp->cb->clock_get_ns(slirp->opaque);
+    if (slirp->busy_drops > 1 &&
+        now - slirp->busy_drop_said_ns < 60 * 1000000000LL) {
+        return true;
+    }
+    slirp->busy_drop_said_ns = now;
+    if (dst && dst->sa_family == AF_INET) {
+        const struct sockaddr_in *sin = (const struct sockaddr_in *)dst;
+        inet_ntop(AF_INET, &sin->sin_addr, addr, sizeof(addr));
+        port = ntohs(sin->sin_port);
+    } else if (dst && dst->sa_family == AF_INET6) {
+        const struct sockaddr_in6 *sin6 = (const struct sockaddr_in6 *)dst;
+        inet_ntop(AF_INET6, &sin6->sin6_addr, addr, sizeof(addr));
+        port = ntohs(sin6->sin6_port);
+    }
+    g_warning("dropped a datagram to %s port %u: the host could not take it "
+              "at once (%s); %" PRIu64 " dropped so far (logged at most "
+              "once a minute)", addr, port, g_strerror(err), slirp->busy_drops);
+    return true;
+}
+
 /*
  * sendto() a socket
  */
@@ -785,7 +839,7 @@ int sosendto(struct socket *so, struct mbuf *m)
     /* Don't care what port we get */
     ret = sendto(so->s, m->m_data, m->m_len, 0, (struct sockaddr *)&addr,
                  sockaddr_size(&addr));
-    if (ret < 0)
+    if (ret < 0 && !sodrop_busy(so->slirp, errno, (struct sockaddr *)&addr))
         return -1;
 
     /*
@@ -889,6 +943,8 @@ struct socket *tcpx_listen(Slirp *slirp,
     }
     setsockopt(s, SOL_SOCKET, SO_OOBINLINE, &opt, sizeof(int));
     slirp_socket_set_nodelay(s);
+    /* A connection reset between poll and accept() must not block accept() */
+    slirp_set_nonblock(s);
 
     addrlen = sizeof(so->fhost);
     getsockname(s, &so->fhost.sa, &addrlen);

diff --git a/src/util.c b/src/util.c
index 95d3219..b749a08 100644
--- a/src/util.c
+++ b/src/util.c
@@ -151,6 +151,12 @@ static void slirp_set_cloexec(slirp_os_socket fd)
 /*
  * Opens a socket with FD_CLOEXEC set
  * On failure errno contains the reason.
+ *
+ * Datagram and raw sockets are non-blocking: slirp sends on them from the
+ * caller's packet path (QEMU's main loop), and a blocking sendto() there
+ * stops the whole VM when the host cannot take the datagram at once
+ * (a full send buffer, a network filter holding earlier data). A datagram
+ * that cannot go now is dropped instead (see sodrop_busy()).
  */
 slirp_os_socket slirp_socket(int domain, int type, int protocol)
 {
@@ -159,12 +165,18 @@ slirp_os_socket slirp_socket(int domain, int type, int protocol)
 #ifdef SOCK_CLOEXEC
     ret = socket(domain, type | SOCK_CLOEXEC, protocol);
     if (ret != -1 || errno != EINVAL) {
+        if (have_valid_socket(ret) && type != SOCK_STREAM) {
+            slirp_set_nonblock(ret);
+        }
         return ret;
     }
 #endif
     ret = socket(domain, type, protocol);
     if (have_valid_socket(ret)) {
         slirp_set_cloexec(ret);
+        if (type != SOCK_STREAM) {
+            slirp_set_nonblock(ret);
+        }
     }
 
     return ret;

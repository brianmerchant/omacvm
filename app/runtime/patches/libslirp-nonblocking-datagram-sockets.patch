diff --git a/src/socket.c b/src/socket.c
index c3870f0..c84a938 100644
--- a/src/socket.c
+++ b/src/socket.c
@@ -576,6 +576,9 @@ void sorecvfrom(struct socket *so)
 
         len = recvfrom(so->s, buff, 256, 0, (struct sockaddr *)&addr, &addrlen);
         /* XXX Check if reply is "correct"? */

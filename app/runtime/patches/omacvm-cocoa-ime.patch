+/* QEMU's view as the input method's client (only with mac-ime on). */
+@implementation QemuCocoaView (OmacVMIme)
+- (NSTextInputContext *)inputContext
+{
+    return omacvm_ime_on && omacvm_ime_active(&omacvm_ime) ? omacvm_ime_ctx : nil;
+}
+
+- (void)insertText:(id)string replacementRange:(NSRange)replacementRange
+{
+    NSString *s = [string isKindOfClass:[NSAttributedString class]] ? [string string] : string;
+    bool was = omacvm_ime_marked != nil;
+
+    if (![s isKindOfClass:[NSString class]]) {
+        return;
+    }
+    omacvm_ime_set_marked(nil);
+    /* Nothing was marked and it is the key's own character: the key itself. */
+    if (!was && omacvm_ime_event && [s isEqualToString:[omacvm_ime_event characters]]) {
+        omacvm_ime_send_key();
+        return;
+    }
+    if ([s length] && omacvm_ime_field()) {
+        omacvm_ime_commit(s);
+    } else if (was) {
+        omacvm_ime_write(@{ @"t": @"cancel" });
+    }
+}
+
+- (void)doCommandBySelector:(SEL)selector
+{
+    /* Return, Tab, arrows, Backspace with nothing marked: the key itself. */
+    omacvm_ime_send_key();
+}
+
+- (void)setMarkedText:(id)string selectedRange:(NSRange)selectedRange
+     replacementRange:(NSRange)replacementRange
+{
+    NSAttributedString *attr = [string isKindOfClass:[NSAttributedString class]] ? string : nil;
+    NSString *s = attr ? [attr string] : string;
+    bool was = omacvm_ime_marked != nil;
+
+    if (![s isKindOfClass:[NSString class]]) {
+        return;
+    }
+    omacvm_ime_set_marked(s);
+    if (![s length]) {
+        if (was) {
+            omacvm_ime_write(@{ @"t": @"cancel" });
+        }
+        return;
+    }
+    if (omacvm_ime_field()) {
+        omacvm_ime_preedit(s, selectedRange, attr);
+    }
+}
+
+- (void)unmarkText
+{
+    /* The input method keeps the marked text as it is. */
+    NSString *s = [[omacvm_ime_marked retain] autorelease];
+
+    omacvm_ime_set_marked(nil);
+    if ([s length] && omacvm_ime_field()) {
+        omacvm_ime_commit(s);
+    }
+}
+
+- (NSRange)selectedRange
+{
+    return NSMakeRange(omacvm_ime_marked ? [omacvm_ime_marked length] : 0, 0);
+}
+
+- (NSRange)markedRange
+{
+    return omacvm_ime_marked ? NSMakeRange(0, [omacvm_ime_marked length]) : NSMakeRange(NSNotFound, 0);

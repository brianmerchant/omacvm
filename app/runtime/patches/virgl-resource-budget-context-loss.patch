+++ b/src/vrend/vrend_decode.c
@@ -1689,6 +1689,13 @@ static void vrend_decode_ctx_attach_resource(struct virgl_context *ctx,
    vrend_renderer_attach_res_ctx(dctx->grctx, res);
 }
 
+/* OmacVM: ctx attached a resource the memory budget refused (virglrenderer.c) */
+void vrend_decode_ctx_refused_resource(struct virgl_context *ctx, uint32_t res_handle)
+{
+   struct vrend_decode_ctx *dctx = (struct vrend_decode_ctx *)ctx;
+   vrend_renderer_context_refused_resource(dctx->grctx, res_handle);
+}
+
 static void vrend_decode_ctx_detach_resource(struct virgl_context *ctx,
                                              struct virgl_resource *res)
 {
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -383,6 +383,8 @@ struct global_renderer_state {
    uint64_t resource_bytes;
    uint64_t resource_budget;
    uint64_t resource_refusals;
+   /* the last vrend_renderer_resource_create failed on the budget */
+   bool resource_refused_last;
 
    uint32_t max_draw_buffers;
    uint32_t max_texture_buffer_size;
@@ -9991,6 +9993,7 @@ static bool vrend_resource_charge(struct vrend_resource *gr,
                     MAX2(args->depth, args->array_size), (unsigned long long)(size >> 10),
                     (unsigned long long)(vrend_state.resource_bytes >> 20),
                     (unsigned long long)n);
+      vrend_state.resource_refused_last = true;
       return false;
    }
    gr->budget_bytes = size;
@@ -10004,6 +10007,31 @@ static void vrend_resource_uncharge(struct vrend_resource *gr)
    gr->budget_bytes = 0;
 }
 
+/* OmacVM: did the last vrend_renderer_resource_create fail on the memory budget? */
+bool vrend_renderer_resource_refused_by_budget(void)
+{
+   return vrend_state.resource_refused_last;
+}
+
+/*
+ * OmacVM: the guest's kernel makes a resource without waiting for the answer, so an
+ * app whose resource the budget refused goes on as if it had it, and its context is
+ * lost later on some command that names it, with no word of why. The context that
+ * made the resource attaches it right away: lose that context there, and say why.
+ * A guest driver that named a reset status buffer is told (GL_GUILTY_CONTEXT_RESET).
+ */
+void vrend_renderer_context_refused_resource(struct vrend_context *ctx, uint32_t res_handle)
+{
+   if (!ctx || !ctx->ctx_id || ctx->in_error)
+      return;
+   virgl_error("context %d (%s) made resource %u past the guest GPU memory budget "
+               "(%llu MB of %llu MB in use): the context is lost\n", ctx->ctx_id,
+               ctx->debug_name, res_handle,
+               (unsigned long long)(vrend_state.resource_bytes >> 20),
+               (unsigned long long)(vrend_state.resource_budget >> 20));
+   vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE, res_handle);
+}
+
 static struct vrend_resource *
 vrend_resource_create(const struct vrend_renderer_resource_create_args *args)
 {
@@ -10039,6 +10067,7 @@ vrend_renderer_resource_create(const struct vrend_renderer_resource_create_args
    struct vrend_resource *gr;
    int ret;
 
+   vrend_state.resource_refused_last = false;
    gr = vrend_resource_create(args);
    if (!gr)
       return NULL;

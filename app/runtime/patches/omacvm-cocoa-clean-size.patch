+/* OmacVM: frames reach the view as IOSurfaces on a plain layer. */
+static bool omacvm_present_layer(void)
+{
+#ifdef CONFIG_OPENGL
+    return display_opengl && cocoa_gl_present_iosurface_wanted();
+#else
+    return false;
+#endif
+}
+
+/*
+ * OmacVM: the guest is the scale size picked for this area: as wide, pixel
+ * for pixel, omacvm_full_cut points shorter.
+ */
+- (bool) omacvmGuestFitsTop:(NSSize)area
+{
+    CGFloat scale = [[self window] backingScaleFactor];
+
+    return omacvm_present_layer() && omacvm_full_cut > 0 &&
+           fabs(screen.width - area.width * scale) < 0.5 &&
+           fabs(screen.height - (area.height - omacvm_full_cut) * scale) < 0.5;
+}
+
+- (void) omacvmGuestAtTop:(bool)top
+{
+    if (top == omacvm_guest_top) {
+        return;
+    }
+    omacvm_guest_top = top;
+    if (omacvm_present_layer()) {
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        /* The layer's y goes up: its top is the screen's top. */
+        [[self layer] setContentsGravity:top ? kCAGravityTop : kCAGravityResize];
+        [CATransaction commit];
+    }
+    [self updateCursorLayout];
 }
 
+/*
+ * OmacVM: where the window sits in full screen. Filling the area (also with
+ * the guest at its top) or as wide as it: at the top, right below the menu
+ * bar or the notch's strip. Narrower (a firmware or boot mode): in the
+ * middle.
+ */
+- (void) placeFullScreen
+{
+    NSWindow *w = [self window];
+    NSRect sf = [[w screen] frame];
+    NSSize area = [self fullScreenSize];
+    NSRect frame = [w frame];
+    CGFloat top = sf.origin.y + area.height;   /* the area ends at the bottom */
+
+    if (![w screen] || frame.size.width < area.width - 0.5) {
+        [w center];
+        return;
+    }
+    frame.origin.x = sf.origin.x + (sf.size.width - frame.size.width) / 2;
+    frame.origin.y = top - frame.size.height;
+    [w setFrameOrigin:frame.origin];
+}

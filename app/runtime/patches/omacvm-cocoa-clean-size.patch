+/*
+ * OmacVM: the window's content in 20 point steps (ui/omacvm-clean-size.h),
+ * so Omarchy's scale presets fit its guest. Not in full screen.
+ */
+static NSRect omacvm_window_on_steps(NSWindow *w, NSRect frame)
+{
+    NSRect c = [w contentRectForFrameRect:frame];
+    CGFloat top = NSMaxY(c);
+
+    c.size.width = omacvm_window_step(c.size.width);
+    c.size.height = omacvm_window_step(c.size.height);
+    c.origin.y = top - c.size.height;
+    return [w frameRectForContentRect:c];
+}
+
+- (NSSize)windowWillResize:(NSWindow *)sender toSize:(NSSize)frameSize
+{
+    NSRect f = [sender frame];
+
+    if (sender != [cocoaView window] ||
+        ([sender styleMask] & NSWindowStyleMaskFullScreen) ||
+        !([sender styleMask] & NSWindowStyleMaskTitled)) {
+        return frameSize;
+    }
+    f.size = frameSize;
+    return omacvm_window_on_steps(sender, f).size;
+}
+
+- (NSRect)windowWillUseStandardFrame:(NSWindow *)window defaultFrame:(NSRect)newFrame
+{
+    if (window != [cocoaView window] ||
+        !([window styleMask] & NSWindowStyleMaskTitled)) {
+        return newFrame;
+    }
+    return omacvm_window_on_steps(window, newFrame);
+}

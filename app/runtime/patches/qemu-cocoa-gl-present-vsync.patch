+/* present_lock held: a new one-second window. */
+static void present_window_reset(double now)
+{
+    present_sync.win_start = now;
+    present_sync.win_ticks = 0;
+    present_sync.win_min = INT_MAX;
+    present_sync.win_late = 0;
+    present_sync.win_frames = 0;
+    present_sync.win_extra = 0;
+    present_sync.win_flushes = 0;
+    present_sync.win_first = present_sync.win_last = 0;
+    present_sync.win_gap = present_sync.win_gap2 = INFINITY;
+}
+
+/*
+ * present_queue: the GPU finished surf. Unlinked, a frame that comes on its
+ * own is shown now; the third close one in a row starts the link at the
+ * screen's full rate. Linked, the frame waits in the queue for a tick; a
+ * frame that comes less than half a tick after the last queued one
+ * replaces it while the guest draws faster than the link, or while the
+ * link runs slower than the screen.
+ */
+static void cocoa_gl_present_queue_frame(IOSurfaceRef surf, GLint filter,
+                                         double flushed)
+{
+    double now = CACurrentMediaTime();
+    PresentFrame drop = { 0 };
+    bool show = false, wake = false, faster = false;
+
+    os_unfair_lock_lock(&present_lock);
+    present_sync.inflight--;

+
+static void surface_put(IOSurfaceRef surf)
+{
+    IOSurfaceDecrementUseCount(surf);
+    CFRelease(surf);
+}
+
+/* Any thread: put a finished frame on the layer. */
+static void cocoa_gl_present_show(IOSurfaceRef surf, GLint filter)
+{
+    CALayer *layer = [cocoaView layer];
+    NSString *f = filter == GL_LINEAR ? kCAFilterLinear : kCAFilterNearest;
+
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    [layer setMagnificationFilter:f];
+    [layer setMinificationFilter:f];
+    [layer setContents:(id)surf];
+    [CATransaction commit];
+}
+
+/* Main thread: give the link the rate present_sync.hz names. */
+static void cocoa_gl_present_link_rate(void)
+{
+    os_unfair_lock_lock(&present_lock);
+    float hz = present_sync.hz;
+    os_unfair_lock_unlock(&present_lock);
+    if (present_link && hz > 0) {
+        [present_link setPreferredFrameRateRange:CAFrameRateRangeMake(hz, hz, hz)];
+        trace_cocoa_present_rate((int)lround(hz));
+    }
+}
+
+/*
+ * Main thread: the window is on a new screen (or the link is new). The link
+ * follows the view's screen by itself; it starts at that screen's full rate
+ * (60, 120, 144 Hz). A ProMotion screen can go down to its slowest rate
+ * (maximumRefreshInterval, 24 Hz on a MacBook Pro); one with a single rate
+ * keeps it.
+ */
+static void cocoa_gl_present_screen_changed(void)
+{
+    if (!present_vsync) {
+        return;
+    }
+    NSScreen *screen = [[cocoaView window] screen];
+    NSInteger max_hz = screen ? [screen maximumFramesPerSecond] : 0;
+    NSTimeInterval longest = screen ? [screen maximumRefreshInterval] : 0;
+    if (max_hz <= 0) {
+        max_hz = 60;
+    }
+    int min_hz = longest > 0 ? (int)lround(1 / longest) : (int)max_hz;
+    min_hz = present_fixed ? (int)max_hz : MAX(1, MIN(min_hz, (int)max_hz));
+
+    os_unfair_lock_lock(&present_lock);
+    bool changed = present_sync.max_hz != max_hz ||
+                   present_sync.min_hz != min_hz;
+    present_sync.max_hz = max_hz;
+    present_sync.min_hz = min_hz;
+    present_sync.hz = max_hz;
+    present_sync.slower = 0;
+    os_unfair_lock_unlock(&present_lock);
+    cocoa_gl_present_link_rate();
+    if (changed) {
+        if (min_hz < max_hz) {
+            info_report("cocoa: frames paced to the window's display, "
+                        "%d-%ld Hz (variable)", min_hz, (long)max_hz);
+        } else {
+            info_report("cocoa: frames paced to the window's display, %ld Hz",
+                        (long)max_hz);
+        }
+    }
+}
+
+/* Main thread: create the display link and its thread once, then run it. */
+static void cocoa_gl_present_link_start(void)
+{
+    if (!present_link) {
+        present_link_target = [[QemuPresentLink alloc] init];
+        present_link = [[cocoaView displayLinkWithTarget:present_link_target
+                                                selector:@selector(tick:)] retain];
+        cocoa_gl_present_screen_changed();
+
+        __block NSRunLoop *loop = nil;
+        dispatch_semaphore_t started = dispatch_semaphore_create(0);
+        NSThread *thread = [[NSThread alloc] initWithBlock:^{
+            loop = [NSRunLoop currentRunLoop];
+            [loop addPort:[NSMachPort port] forMode:NSDefaultRunLoopMode];
+            dispatch_semaphore_signal(started);
+            [loop run];
+        }];
+        [thread setName:@"org.omacvm.vsync"];
+        [thread setQualityOfService:NSQualityOfServiceUserInteractive];
+        [thread start];
+        dispatch_semaphore_wait(started, DISPATCH_TIME_FOREVER);
+        dispatch_release(started);
+        [present_link addToRunLoop:loop forMode:NSDefaultRunLoopMode];
+    } else {
+        cocoa_gl_present_link_rate();
+    }
+    [present_link setPaused:NO];
+}

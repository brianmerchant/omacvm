+/* The "#version" emit_header() writes on desktop GL. */
+static int desktop_glsl_ver(const struct dump_ctx *ctx)
+{
+   if (ctx->prog_type == TGSI_PROCESSOR_COMPUTE)
+      return 330;
+   if (ctx->glsl_ver_required > 150)
+      return ctx->glsl_ver_required;
+   if (ctx->prog_type == TGSI_PROCESSOR_GEOMETRY ||
+       ctx->prog_type == TGSI_PROCESSOR_TESS_EVAL ||
+       ctx->prog_type == TGSI_PROCESSOR_TESS_CTRL ||
+       ctx->glsl_ver_required == 150)
+      return 150;
+   return ctx->glsl_ver_required == 140 ? 140 : 130;
+}
+
+static bool ext_is_core(const struct dump_ctx *ctx, const char *name)
+{
+   if (ctx->cfg->use_gles)
+      return false;
+   for (unsigned i = 0; i < ARRAY_SIZE(ext_core_glsl_ver); i++) {
+      if (!strcmp(name, ext_core_glsl_ver[i].name))
+         return desktop_glsl_ver(ctx) >= ext_core_glsl_ver[i].glsl_ver;
+   }
+   return false;
+}

From: OmacVM
Subject: [PATCH] venus: stream sockets on macOS

macOS has no SOCK_SEQPACKET for AF_UNIX (EPROTONOSUPPORT), so the render
server never started. Use SOCK_STREAM there. The sockets already frame
messages when they are not seqpacket, but treated every short read as an
error; a stream may return part of a message (0 bytes = the peer closed),
fds arrive with the first bytes only, and a message must fit the buffer.

Upstream: not sent (macOS only).
Test: Venus starts in an app VM (vulkaninfo, vkmark); Vulkan CTS smoke.

diff --git a/server/render_socket.c b/server/render_socket.c
index 3201da6..0563a5a 100644
--- a/server/render_socket.c
+++ b/server/render_socket.c
@@ -53,7 +53,8 @@ bool
 render_socket_pair(int out_fds[static 2])
 {
 #ifdef __APPLE__
-   int type = SOCK_SEQPACKET;
+   /* macOS has no SOCK_SEQPACKET for AF_UNIX: stream, with framing */
+   int type = SOCK_STREAM;
 #else
    int type = SOCK_SEQPACKET;
 #endif
@@ -167,18 +168,28 @@ render_socket_recvmsg(struct render_socket *socket, struct msghdr *msg, size_t *
          return false;
       }
 
+      bool bad = _msg.msg_flags & MSG_CTRUNC;
+      if (socket->is_seqpacket)
+         bad = bad || (_msg.msg_flags & MSG_TRUNC) ||
+               _msg.msg_iov[0].iov_len != (size_t)s;
+      else
+         /* a stream may return part of a message; 0 means the peer closed */
+         bad = bad || (s == 0 && _msg.msg_iov[0].iov_len > 0);
+
       if (state == SOCKET_STATE_FIRST_MSG) {
          _msg_controllen = _msg.msg_controllen;
          state = socket->is_seqpacket ? SOCKET_STATE_DATA : SOCKET_STATE_HEADER;
+         if (!bad && !socket->is_seqpacket) {
+            /* fds come with the first bytes only; keep them */
+            _msg.msg_control = NULL;
+            _msg.msg_controllen = 0;
+         }
       } else {
          /* retain the cmsg from first message */
          assert(_msg.msg_controllen == 0);
       }
 
-      if (unlikely(_msg.msg_flags & MSG_CTRUNC ||
-                   (socket->is_seqpacket &&
-                     (_msg.msg_flags & MSG_TRUNC) ||
-                      _msg.msg_iov[0].iov_len != (size_t)s))) {
+      if (unlikely(bad)) {
          render_log("failed to receive message: truncated or incomplete");
 
          int fd_count;
@@ -201,6 +212,10 @@ render_socket_recvmsg(struct render_socket *socket, struct msghdr *msg, size_t *
 
       if (!want && state == SOCKET_STATE_HEADER) {
          want = ntohl(hdr.length);
+         if (unlikely((size_t)want > msg->msg_iov[0].iov_len)) {
+            render_log("failed to receive message: %zd bytes do not fit", want);
+            return false;
+         }
          _msg.msg_iov[0].iov_base = msg->msg_iov[0].iov_base;
          _msg.msg_iov[0].iov_len = want;
          state = SOCKET_STATE_DATA;

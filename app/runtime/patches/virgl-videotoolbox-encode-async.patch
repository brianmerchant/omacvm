+
+/* Releases what a job holds on vrend's thread (picture, fence, options). */
+static void enc_job_release(struct enc_job *job)
+{
+    if (job->src)
+        CVPixelBufferRelease(job->src);
+    job->src = NULL;
+    if (job->gpu_fence && callbacks && callbacks->gpu_fence_destroy)
+        callbacks->gpu_fence_destroy(job->gpu_fence);
+    job->gpu_fence = NULL;
+    if (job->props)
+        CFRelease(job->props);
+    job->props = NULL;

+#include <dlfcn.h>
 #include <AppKit/NSOpenGL.h>
 #ifdef CONFIG_OPENGL
 #import <IOSurface/IOSurface.h>
@@ -339,7 +341,12 @@ static bool cocoa_host_keyboard_is_iso(void)
 static int cocoa_keycode_to_linux(int keycode)
 {
     int linux_keycode;
+    /* OmacVM: Apple's own top-row keys reach the VM as their F-key. */
+    int special = omacvm_special_key(keycode);
 

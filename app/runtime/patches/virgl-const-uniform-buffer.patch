+/* Where constants may start in a buffer: a range offset glBindBufferRange takes, and
+ * whole vec4s for a vertex shader's window index. */
+static uint32_t vrend_const_align(void)
+{
+   return MAX2(vrend_state.ubo_offset_alignment, 16);
+}
+
+/* The payloads of a submit's SET_CONSTANT_BUFFER commands, copied into one staging block
+ * before the submit is decoded (vrend_decode.c). Nothing else is read or trusted: the
+ * decode checks each command as before, and a payload is used only when vrend_set_constants
+ * gets that same payload (vrend_const_take). Stops at the first command whose length runs
+ * past the buffer, and at VREND_CONST_PRESCAN_MAX bytes. Compute constants stay uniforms,
+ * and so do all constants of a context whose shaders cannot have the block.
+ * A vertex shader's window index counts whole vec4s, so vertex constants start at the next
+ * 16 bytes when windows are on; a range bound per draw starts at the GL's alignment. The
+ * bytes between entries are zeroed: the staging block goes to the GPU as it is. */
+void vrend_const_prescan(struct vrend_context *ctx, const uint32_t *buf, uint32_t ndw)
+{
+   struct vrend_const_prescan *p = &ctx->const_prescan;
+
+   p->count = p->next = 0;
+   p->staging_size = 0;
+   p->uploaded = false;
+   p->active = p->has_vertex = false;
+   if (!vrend_state.use_const_ubo || !ctx->shader_cfg.use_const_ubo)
+      return;
+   p->active = true;
+   p->seq++;
+
+   for (uint32_t off = 0; off < ndw;) {
+      const uint32_t *cmd = buf + off;
+      uint32_t len = cmd[0] >> 16;
+      if (len >= ndw - off)
+         break;
+      off += len + 1;
+
+      if ((cmd[0] & 0xff) != VIRGL_CCMD_SET_CONSTANT_BUFFER || len <= 2 ||
+          cmd[1] >= PIPE_SHADER_TYPES || cmd[1] == PIPE_SHADER_COMPUTE)
+         continue;
+
+      bool vertex = cmd[1] == PIPE_SHADER_VERTEX;
+      uint32_t align = vertex && vrend_state.const_ubo_index_loc ? 16 : vrend_const_align();
+      uint32_t bytes = (len - 2) * 4;
+      uint32_t at = (p->staging_size + align - 1) / align * align;
+      if (at > VREND_CONST_PRESCAN_MAX || bytes > VREND_CONST_PRESCAN_MAX - at)
+         break;
+      if (at + bytes > p->staging_cap) {
+         uint32_t cap = MAX2(at + bytes, MIN2(2 * p->staging_cap, VREND_CONST_PRESCAN_MAX));
+         uint8_t *staging = realloc(p->staging, cap);
+         if (!staging)
+            break;
+         p->staging = staging;
+         p->staging_cap = cap;
+      }
+      if (p->count == p->cap) {
+         uint32_t cap = p->cap ? 2 * p->cap : 1024;
+         struct vrend_const_entry *e = realloc(p->e, cap * sizeof(*e));
+         if (!e)
+            break;
+         p->e = e;
+         p->cap = cap;
+      }
+      memset(p->staging + p->staging_size, 0, at - p->staging_size);
+      memcpy(p->staging + at, cmd + 3, bytes);
+      p->e[p->count++] = (struct vrend_const_entry){ cmd + 3, at, bytes };
+      p->staging_size = at + bytes;
+      p->has_vertex |= vertex;
+   }
+}
+
+/* The submit's buffer is gone after its decode: no entry may outlive it, and constants
+ * not uploaded by then go one by one (vrend_const_resolve). */
+void vrend_const_prescan_end(struct vrend_context *ctx)
+{
+   ctx->const_prescan.count = ctx->const_prescan.next = 0;
+   ctx->const_prescan.active = false;
+}
+
+/* The constants vrend_set_constants just stored, if they are the next entries of the
+ * prescan: they point into the staging block (VREND_CONST_PENDING); the first draw that
+ * needs any of them uploads it (vrend_const_resolve). */
+static void vrend_const_take(struct vrend_context *ctx, struct vrend_constants *consts,
+                             const void *data)
+{
+   struct vrend_const_prescan *p = &ctx->const_prescan;
+
+   /* the decode runs the commands in order: entries before data were skipped */
+   while (p->next < p->count && (const char *)p->e[p->next].data < (const char *)data)
+      p->next++;
+   if (p->next == p->count || p->e[p->next].data != data)
+      return;
+   const struct vrend_const_entry *e = &p->e[p->next++];
+
+   consts->ubo_ok = true;
+   consts->ubo_id = 0;
+   consts->ubo_offset = e->offset;
+   consts->ubo_bytes = e->bytes;
+   consts->ubo_slot = VREND_CONST_PENDING;
+   consts->ubo_gen = p->seq;
+}
+
+/* Pending constants at a draw: the submit's staging block goes into the next buffer of
+ * this sub context's ring with one glBufferData (the first draw of the submit that needs
+ * it), padded by a window of zeros when vertex windows may start at any of its constants.
+ * Constants of an earlier submit, or of another sub context than the one that uploaded,
+ * go one by one (ubo_ok false: vrend_const_own_buffer). No glGetError here: a draw is
+ * being set up, and vrend_draw_state_ok takes the GL's errors for it (a failed upload
+ * skips the draws that bind it). */
+static void vrend_const_resolve(struct vrend_sub_context *sub, struct vrend_constants *consts)
+{
+   struct vrend_const_prescan *p = &sub->parent->const_prescan;
+
+   if (consts->ubo_slot != VREND_CONST_PENDING)
+      return;
+   consts->ubo_ok = false;
+   if (!p->active || p->seq != consts->ubo_gen ||
+       (p->uploaded && p->sub_serial != sub->serial))
+      return;
+
+   if (!p->uploaded) {
+      uint32_t pad = p->has_vertex && vrend_state.const_ubo_index_loc ?
+                     vrend_state.const_ubo_max_vec4 * 16 : 0;
+      if (p->staging_size + pad > p->staging_cap) {
+         uint8_t *staging = realloc(p->staging, p->staging_size + pad);
+         if (!staging) {
+            p->active = false;
+            return;
          }
+         p->staging = staging;
+         p->staging_cap = p->staging_size + pad;

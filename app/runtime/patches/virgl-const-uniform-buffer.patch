+/* Where constants may start in a buffer: a range offset glBindBufferRange takes, and
+ * whole vec4s for a vertex shader's window index. */
+static uint32_t vrend_const_align(void)
+{
+   return MAX2(vrend_state.ubo_offset_alignment, 16);
+}
+
+/* The payloads of a submit's SET_CONSTANT_BUFFER commands, copied into one staging block
+ * before the submit is decoded (vrend_decode.c). Nothing else is read or trusted: the
+ * decode checks each command as before, and a payload is used only when vrend_set_constants
+ * gets that same payload (vrend_const_take). Stops at the first command whose length runs
+ * past the buffer, and at VREND_CONST_PRESCAN_MAX bytes. Compute constants stay uniforms. */
+void vrend_const_prescan(struct vrend_context *ctx, const uint32_t *buf, uint32_t ndw)
+{
+   struct vrend_const_prescan *p = &ctx->const_prescan;
+   const uint32_t align = vrend_const_align();
+
+   p->count = p->next = 0;
+   p->staging_size = 0;
+   p->uploaded = false;
+   if (!vrend_state.use_const_ubo)
+      return;
+
+   for (uint32_t off = 0; off < ndw;) {
+      const uint32_t *cmd = buf + off;
+      uint32_t len = cmd[0] >> 16;
+      if (len >= ndw - off)
+         break;
+      off += len + 1;
+
+      if ((cmd[0] & 0xff) != VIRGL_CCMD_SET_CONSTANT_BUFFER || len <= 2 ||
+          cmd[1] >= PIPE_SHADER_TYPES || cmd[1] == PIPE_SHADER_COMPUTE)
+         continue;
+
+      uint32_t bytes = (len - 2) * 4;
+      uint32_t at = (p->staging_size + align - 1) / align * align;
+      if (at > VREND_CONST_PRESCAN_MAX || bytes > VREND_CONST_PRESCAN_MAX - at)
+         break;
+      if (at + bytes > p->staging_cap) {
+         uint32_t cap = MAX2(at + bytes, MIN2(2 * p->staging_cap, VREND_CONST_PRESCAN_MAX));
+         uint8_t *staging = realloc(p->staging, cap);
+         if (!staging)
+            break;
+         p->staging = staging;
+         p->staging_cap = cap;
+      }
+      if (p->count == p->cap) {
+         uint32_t cap = p->cap ? 2 * p->cap : 1024;
+         struct vrend_const_entry *e = realloc(p->e, cap * sizeof(*e));
+         if (!e)
+            break;
+         p->e = e;
+         p->cap = cap;
+      }
+      memcpy(p->staging + at, cmd + 3, bytes);
+      p->e[p->count++] = (struct vrend_const_entry){ cmd + 3, at, bytes };
+      p->staging_size = at + bytes;
+   }
+}
+
+/* The submit's buffer is gone after its decode: no entry may outlive it. */
+void vrend_const_prescan_end(struct vrend_context *ctx)
+{
+   ctx->const_prescan.count = ctx->const_prescan.next = 0;
+}
+
+/* The constants vrend_set_constants just stored, if they are the next entries of the
+ * prescan: the first one uploads the whole staging block into the current sub context's
+ * ring; later ones in another sub context go one by one (vrend_const_own_buffer). */
+static void vrend_const_take(struct vrend_context *ctx, struct vrend_constants *consts,
+                             const void *data)
+{
+   struct vrend_const_prescan *p = &ctx->const_prescan;
+   struct vrend_sub_context *sub = ctx->sub;
+
+   /* the decode runs the commands in order: entries before data were skipped */
+   while (p->next < p->count && (const char *)p->e[p->next].data < (const char *)data)
+      p->next++;
+   if (p->next == p->count || p->e[p->next].data != data)
+      return;
+   const struct vrend_const_entry *e = &p->e[p->next++];
+
+   if (!p->uploaded) {
+      /* a vertex shader's window may start at any constants and runs window bytes on */
+      uint32_t pad = vrend_state.const_ubo_index_loc ? vrend_state.const_ubo_max_vec4 * 16 : 0;
+      if (p->staging_size + pad > p->staging_cap) {
+         uint8_t *staging = realloc(p->staging, p->staging_size + pad);
+         if (!staging) {
+            p->count = 0;
+            return;
+         }
+         p->staging = staging;
+         p->staging_cap = p->staging_size + pad;
+      }
+      uint32_t slot = sub->const_ring.next++ % VREND_CONST_RING;
+      if (!sub->const_ring.ids[slot])
+         glGenBuffers(1, &sub->const_ring.ids[slot]);
+      sub->const_ring.gen[slot]++;
+      glBindBuffer(GL_UNIFORM_BUFFER, sub->const_ring.ids[slot]);
+      glBufferData(GL_UNIFORM_BUFFER, p->staging_size + pad, p->staging, GL_STREAM_DRAW);
+      glBindBuffer(GL_UNIFORM_BUFFER, 0);
+      if (glGetError() != GL_NO_ERROR || !sub->const_ring.ids[slot]) {
+         /* nothing of this submit goes through the ring */
+         sub->const_ring.gen[slot]++;
+         p->count = 0;
+         return;
+      }
+      p->uploaded = true;
+      p->sub_serial = sub->serial;
+      p->id = sub->const_ring.ids[slot];
+      p->slot = slot;
+      p->gen = sub->const_ring.gen[slot];
+      vrend_const_stats.uploads++;
+      vrend_const_stats.upload_bytes += p->staging_size + pad;
+   } else if (p->sub_serial != sub->serial) {
+      return;
+   }
+
+   consts->ubo_ok = true;
+   consts->ubo_id = p->id;
+   consts->ubo_offset = e->offset;
+   consts->ubo_bytes = e->bytes;
+   consts->ubo_slot = p->slot;
+   consts->ubo_gen = p->gen;
+}
+
+/* The stage's constants into its own buffer, zero-padded to the block's size: for
+ * constants that did not come through the prescan, an upload that is no longer current
+ * (its ring buffer took a later submit), or a block larger than what the guest sent.
+ * The buffer gets new storage each time (no wait for draws that still read the old). */
+static void vrend_const_own_buffer(struct vrend_sub_context *sub_ctx, int shader_type,
+                                   uint32_t bytes, uint32_t size)
+{
+   static const uint8_t zeros[4096];
+   struct vrend_constants *consts = &sub_ctx->consts[shader_type];
+   uint32_t have = consts->consts ? MIN2(consts->num_consts * 4, bytes) : 0;
+
+   if (!sub_ctx->const_own[shader_type])
+      glGenBuffers(1, &sub_ctx->const_own[shader_type]);
+   glBindBuffer(GL_UNIFORM_BUFFER, sub_ctx->const_own[shader_type]);
+   glBufferData(GL_UNIFORM_BUFFER, size, NULL, GL_STREAM_DRAW);
+   if (have)
+      glBufferSubData(GL_UNIFORM_BUFFER, 0, have, consts->consts);
+   for (uint32_t at = have; at < bytes; at += sizeof(zeros))
+      glBufferSubData(GL_UNIFORM_BUFFER, at, MIN2(sizeof(zeros), bytes - at), zeros);
+   glBindBuffer(GL_UNIFORM_BUFFER, 0);
+
+   consts->ubo_ok = true;
+   consts->ubo_id = sub_ctx->const_own[shader_type];
+   consts->ubo_offset = 0;
+   consts->ubo_bytes = bytes;
+   consts->ubo_slot = VREND_CONST_RING;
+   consts->ubo_gen = 0;
+   vrend_const_stats.own_uploads++;
+}
+
+/* A draw binds its stage's constants range (every draw: other programs use the same
+ * binding points, as for the VirglBlock). The range always covers the whole block. */
+static void vrend_draw_bind_const_block(struct vrend_sub_context *sub_ctx, int shader_type)
+{
+   struct vrend_linked_shader_program *prog = sub_ctx->prog;
+   struct vrend_constants *consts = &sub_ctx->consts[shader_type];
+   bool window = shader_type == PIPE_SHADER_VERTEX && prog->const_index;
+   /* the bytes the shader reads, and the range it is bound with */
+   uint32_t size = prog->const_block_size[shader_type];
+   uint32_t bytes = window ? prog->ss[shader_type]->sel->sinfo.num_consts * 16 : size;
+
+   if (!consts->ubo_ok || consts->ubo_bytes < bytes ||
+       (consts->ubo_slot < VREND_CONST_RING &&
+        sub_ctx->const_ring.gen[consts->ubo_slot] != consts->ubo_gen))
+      vrend_const_own_buffer(sub_ctx, shader_type, bytes, size);
+
+   if (!window) {
+      glBindBufferRange(GL_UNIFORM_BUFFER, prog->const_block_bind[shader_type] - 1,
+                        consts->ubo_id, consts->ubo_offset, size);
+      vrend_const_stats.binds++;
+      return;
+   }
+
+   /* A window of size bytes from an aligned start at or before the constants; the ring
+    * upload is padded by a window and the own buffer is one, so it stays inside. */
+   uint32_t start = sub_ctx->const_win_start;

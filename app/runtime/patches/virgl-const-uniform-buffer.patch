+   uint32_t use_const_ubo : 1;
+   /* uniform blocks one stage may use, and vec4s one block may hold, on the host GL */
+   uint32_t const_ubo_max_blocks : 8;
+   uint32_t const_ubo_max_vec4 : 16;
+   /* the vertex attribute location of virgl_cbase (const_ubo_index); 0: off */
+   uint32_t const_ubo_index_loc : 7;
 };
 
 struct vrend_context;

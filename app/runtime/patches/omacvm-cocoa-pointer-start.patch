@@ -2443,10 +2549,23 @@ - (NSApplicationPresentationOptions) window:(NSWindow *)window
 - (void) windowDidResignKey: (NSNotification *)aNotification
 {
     COCOA_DEBUG("%s\n", __func__);
+    omacvm_pointer_left(&omacvm_ptr);
     [cocoaView ungrabMouse];
     [cocoaView raiseAllKeys];
 }
 
+/*
+ * OmacVM: the window became key (OmacVM.app handed it the focus after a
+ * start, the escape combo came back, Command-Tab): the pointer on it is
+ * the VM's at once. After AppKit's own handling of the key change.
+ */
+- (void) windowDidBecomeKey: (NSNotification *)aNotification
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [cocoaView omacvmTakePointer:nil why:"window key"];
+    });
+}
+
 /* We abstract the method called by the Enter Fullscreen menu item
  * because Mac OS 10.7 and higher disables it. This is because of the
  * menu item's old selector's name toggleFullScreen:
@@ -4863,8 +4982,11 @@ static void omacvm_guard_corners(NSEvent *event)
     if (!on) {
         s.nours = 0;    /* never takes hold */
     }
-    /* The Mac's cursor is the only pointer shown (show-cursor=on): it follows. */
-    omacvm_guard.follow = !cursor_hide;
+    /*
+     * The Mac's cursor is shown (show-cursor=on, or the guest draws no
+     * pointer yet): it follows.
+     */
+    omacvm_guard.follow = !omacvm_mac_cursor_hidden;
     omacvm_guard_event(&omacvm_guard, &s, [event timestamp], loc.x, loc.y,
                        dx, dy, cur.x, cur.y, &st);
     omacvm_guard_apply(&st);
@@ -5725,6 +5847,12 @@ static void omacvm_chan_line(NSData *data)
         NSDictionary *d = obj;
         bool update = false;
         if (d[@"hello"]) {
+            if (!omacvm_ptr.drawing) {
+                info_report("cocoa: the guest draws its own pointer now");
+            }
+            omacvm_pointer_guest_hello(&omacvm_ptr);
+            [cocoaView omacvmUpdateMacCursor];
+            [cocoaView omacvmTakePointer:nil why:"guest pointer up"];
             omacvm_guest_ready = true;
             [omacvm_last_layout release];
             omacvm_last_layout = nil;
@@ -5823,6 +5951,73 @@ static void omacvm_chan_connect(void)
     dispatch_resume(omacvm_chan_src);
 }
 
+/* A guest reset (QEMU's thread, BQL): its firmware and boot draw no pointer. */
+static void omacvm_pointer_reset(void *opaque)
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        omacvm_pointer_guest_reset(&omacvm_ptr);
+        [cocoaView omacvmUpdateMacCursor];
+    });
+}
+
+/*
+ * Test (OMACVM_TEST_POINTER=<seconds>, test mode only): made-up motion over
+ * the main view four times a second, from the start, through AppKit's
+ * entry for it (mouseMoved:), as if the user moved the mouse and never
+ * clicked. Never the real cursor: the window counts as key and in front,
+ * the guard is off for it, and the Mac's cursor is only logged.
+ */
+static void omacvm_test_motion(int tick, int ticks)
+{
+    NSWindow *w = [cocoaView window];
+    NSRect b = [cocoaView bounds];
+    double t = tick * 0.35;
+    NSPoint p;
+    NSEvent *e;
+
+    if (tick >= ticks) {
+        info_report("omacvm-pointer: test motion done (%d moves)", ticks);
+        return;
+    }
+    p = NSMakePoint(NSMidX(b) + cos(t) * b.size.width / 4,
+                    NSMidY(b) + sin(t) * b.size.height / 4);
+    e = [NSEvent mouseEventWithType:NSEventTypeMouseMoved
+                           location:[cocoaView convertPoint:p toView:nil]
+                      modifierFlags:0
+                          timestamp:[[NSProcessInfo processInfo] systemUptime]
+                       windowNumber:[w windowNumber]
+                            context:nil
+                        eventNumber:0
+                         clickCount:0
+                           pressure:0];
+    if (e && [w isVisible]) {
+        [cocoaView mouseMoved:e];
+    }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC / 4),
+                   dispatch_get_main_queue(), ^{ omacvm_test_motion(tick + 1, ticks); });
+}
+
+/* Main thread, with the BQL (from omacvm_displays_init). */
+static void omacvm_pointer_init(void)
+{
+    const char *v = getenv("OMACVM_POINTER_START");
+    const char *test = getenv("OMACVM_TEST_POINTER");
+
+    omacvm_ptr.off = v && !strcmp(v, "0");
+    omacvm_test_pointer = test && atoi(test) > 0 && omacvm_test_mode();
+    omacvm_pointer_debug = omacvm_test_pointer ||
+                           (getenv("OMACVM_POINTER_DEBUG") &&
+                            !strcmp(getenv("OMACVM_POINTER_DEBUG"), "1"));
+    qemu_register_reset(omacvm_pointer_reset, NULL);
+    info_report("cocoa: pointer: %s", omacvm_ptr.off ?
+                "taken on enter or click (OMACVM_POINTER_START=0)" :
+                "taken without a click when it is on the VM");
+    if (omacvm_test_pointer) {
+        int ticks = atoi(test) * 4;
+        dispatch_async(dispatch_get_main_queue(), ^{ omacvm_test_motion(0, ticks); });
+    }
+}
+
 /* Main thread, with the BQL (from cocoa_display_init). */
 static void omacvm_displays_init(void)
 {
@@ -5868,10 +6063,19 @@ static void omacvm_displays_init(void)
                     object:nil
                      queue:[NSOperationQueue mainQueue]
                 usingBlock:^(NSNotification *note) {
+        omacvm_pointer_left(&omacvm_ptr);
         if ([cocoaView isMouseGrabbed]) {
             [cocoaView ungrabMouse];
         }
     }];
+    [[NSNotificationCenter defaultCenter]
+        addObserverForName:NSApplicationDidBecomeActiveNotification
+                    object:nil
+                     queue:[NSOperationQueue mainQueue]
+                usingBlock:^(NSNotification *note) {
+        [cocoaView omacvmTakePointer:nil why:"app active"];
+    }];
+    omacvm_pointer_init();
     omacvm_update_mac_layout();
     omacvm_chan_connect();
 }

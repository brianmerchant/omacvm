-- (void) hideCursor
+/*
+ * OmacVM: the Mac's cursor over the VM, hidden or shown from one place
+ * (ui/omacvm-pointer-start.h says when). [NSCursor hide] counts: a second
+ * grab without a let-go between (full screen) hid it twice, and one unhide
+ * then left it hidden.
+ */
+- (void) omacvmUpdateMacCursor
 {
-    if (!cursor_hide) {
+    bool hide = omacvm_pointer_hide_mac(&omacvm_ptr, cursor_hide, isMouseGrabbed,
+                                        isAbsoluteEnabled);
+
+    if (hide == omacvm_mac_cursor_hidden) {
         return;
     }
-    [NSCursor hide];
+    omacvm_mac_cursor_hidden = hide;
+    if (omacvm_pointer_debug) {
+        info_report("omacvm-pointer: Mac cursor %s", hide ? "hidden" : "shown");
+    }
+    if (omacvm_test_pointer) {
+        return;     /* test: never the real cursor (the user works meanwhile) */
+    }
+    if (hide) {
+        [NSCursor hide];
+    } else {
+        [NSCursor unhide];
+    }
+}
+
+/* OmacVM: the pointer is on the VM's picture (this view), nothing above it. */
+- (bool) omacvmPointerOver:(NSEvent *)event
+{
+    NSWindow *w = [self window];
+    NSPoint p;
+
+    if (!w || ![w isVisible] ||
+        !([w occlusionState] & NSWindowOcclusionStateVisible)) {
+        return false;
+    }
+    if (event && [event window] == w) {
+        p = [self convertPoint:[event locationInWindow] fromView:nil];
+    } else {
+        p = [self convertPoint:[w convertPointFromScreen:[NSEvent mouseLocation]]
+                      fromView:nil];
+    }
+    if (!NSPointInRect(p, [self visibleRect])) {
+        return false;
+    }
+    /* Test: the motion is made up; the real cursor is elsewhere. */
+    return omacvm_test_pointer ||
+           [NSWindow windowNumberAtPoint:[NSEvent mouseLocation]
+             belowWindowWithWindowNumber:0] == [w windowNumber];
 }
 
-- (void) unhideCursor
+/*
+ * OmacVM: take the pointer without a click (ui/omacvm-pointer-start.h): on
+ * the first motion over the VM, or event nil: now (the window became key,
+ * the app active, full screen, the guest's pointer came up), when the
+ * pointer is on the VM.
+ */
+- (void) omacvmTakePointer:(NSEvent *)event why:(const char *)why
+{
+    OmacVMPointerIn in = {
+        .absolute = isAbsoluteEnabled,
+        .grabbed = isMouseGrabbed,
+        .active = omacvm_test_pointer || [NSApp isActive],
+        .key = omacvm_test_pointer || omacvm_is_our_window([NSApp keyWindow]),
+        .over = [self omacvmPointerOver:event],
+        .buttons = !omacvm_test_pointer && [NSEvent pressedMouseButtons] != 0,
+    };
+
+    if (omacvm_pointer_take(&omacvm_ptr, &in)) {
+        if (omacvm_pointer_debug) {
+            info_report("omacvm-pointer: taken (%s)", why);
+        }
+        [self grabMouse];
+    }
+}
+
+- (void) omacvmFullScreenTake
 {
-    if (!cursor_hide) {
+    if (isMouseGrabbed) {
+        return;
+    }
+    if (omacvm_ptr.off || !isAbsoluteEnabled) {
+        [self grabMouse];       /* as upstream */
         return;
     }
-    [NSCursor unhide];
+    [self omacvmTakePointer:nil why:"full screen"];
 }
 
 - (void)updateCursorLayout

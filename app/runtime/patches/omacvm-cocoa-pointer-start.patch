 }
 
@@ -1922,10 +2012,11 @@ - (void) grabMouse
         [[self window] setTitle:[NSString stringWithFormat:@"%s - (Press  " UC_CTRL_KEY " " UC_ALT_KEY " G  to release Mouse)", qemu_name]];
     else
         [[self window] setTitle:@"QEMU - (Press  " UC_CTRL_KEY " " UC_ALT_KEY " G  to release Mouse)"];
-    [self hideCursor];
     omacvm_corner_release();
     CGAssociateMouseAndMouseCursorPosition(isAbsoluteEnabled);
     isMouseGrabbed = TRUE; // while isMouseGrabbed = TRUE, QemuCocoaApp sends all events to [cocoaView handleEvent:]
+    omacvm_pointer_left(&omacvm_ptr);
+    [self omacvmUpdateMacCursor];
 }
 
 - (void) ungrabMouse
@@ -1936,10 +2027,10 @@ - (void) ungrabMouse

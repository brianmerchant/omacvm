+    /* OmacVM: no click needed when the pointer is already on the VM. */
+    [self omacvmTakePointer:nil why:"absolute pointer"];
 }
 - (BOOL) isMouseGrabbed {return isMouseGrabbed;}
 
@@ -2130,6 +2224,18 @@ - (BOOL)canBecomeMainWindow { return YES; }
 
 static BOOL notchFull;
 static NSRect notchSavedFrame;
+
+/*
+ * Full screen takes the pointer. An absolute one only while the app is in

From: OmacVM
Subject: [PATCH] cocoa: the full-grab tap goes when Accessibility is taken away

What: without Accessibility, QEMU's full-grab event tap is removed (disabled,
its Mach port and run-loop source invalidated) and never enabled again;
system shortcuts go to macOS until the VM is started again. Looked at every
second (AXIsProcessTrusted is a cached call), when macOS posts that its
Accessibility list changed (com.apple.accessibility.api), and when macOS
disables the tap (reenableEventTap, qemu-cocoa-full-grab-reenable.patch).

Why: issue #192. The tap is an active filter at the head of the HID chain.
When the user takes Accessibility away while it exists, macOS keeps it in the
chain but no longer takes the events it hands back ("Sender is prohibited
from synthesizing events") and disables it on timeout; reenableEventTap
enabled it again at once, so the Mac's keys stayed held until the process
ended. OmacVM Gestures and the Bridge had the same loop and follow the same
rule.

Upstream: not sent (it builds on the Try Omarchy full-grab patches).

Test: app/runtime/Tests/keys/test-tap-permission.sh (CI: the methods from this
patch with a made-up tap and permission; the runtime build: the same against
the patched ui/cocoa.m). Applies last of the cocoa patches.

--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -489,6 +489,7 @@
 - (BOOL) isMouseGrabbed;
 - (BOOL) isKeyboardCaptured;
 - (void) reenableEventTap;
+- (BOOL) omacvmKeepTap;
 - (void) raiseAllKeys;
 #ifdef CONFIG_OPENGL
 - (void)useCGLLayer;
@@ -1878,6 +1879,23 @@
 
     CFRunLoopAddSource(runLoop, tapEventsSrc, kCFRunLoopDefaultMode);
     CFRelease(tapEventsSrc);
+
+    /* OmacVM: the tap goes when Accessibility does (omacvmKeepTap). */
+    NSTimer *permission = [NSTimer timerWithTimeInterval:1.0 repeats:YES block:^(NSTimer *t) {
+        if (![self omacvmKeepTap]) {
+            [t invalidate];
+        }
+    }];
+    [permission setTolerance:0.1];
+    [[NSRunLoop mainRunLoop] addTimer:permission forMode:NSRunLoopCommonModes];
+    [[NSDistributedNotificationCenter defaultCenter]
+        addObserverForName:@"com.apple.accessibility.api" object:nil
+                     queue:[NSOperationQueue mainQueue]
+                usingBlock:^(NSNotification *note) {
+        [self omacvmKeepTap];
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 300 * NSEC_PER_MSEC),
+                       dispatch_get_main_queue(), ^{ [self omacvmKeepTap]; });
+    }];
 }
 
 - (void) toggleKey: (unsigned int)keycode {
@@ -2651,12 +2669,49 @@
  */
 - (void) reenableEventTap
 {
-    if (eventsTap) {
-        CGEventTapEnable(eventsTap, true);
+    if (!eventsTap) {
+        return;
     }
+    /*
+     * OmacVM: never again without Accessibility; the tap goes once this
+     * callback has returned (omacvmKeepTap).
+     */
+    if (!AXIsProcessTrusted()) {
+        dispatch_async(dispatch_get_main_queue(), ^{ [self omacvmKeepTap]; });
+        return;
+    }
+    CGEventTapEnable(eventsTap, true);
 }
 
 /*
+ * OmacVM (issue #192): the full-grab tap is an active filter at the head of
+ * the HID chain and needs Accessibility. When the user takes it away while
+ * the VM runs, macOS keeps the tap in the chain but no longer takes the
+ * events it hands back and disables it on timeout; enabling it again
+ * (reenableEventTap) held the Mac's keys until the process ended. So without
+ * Accessibility the tap goes at once, and for good: system shortcuts stay
+ * with macOS until the VM is started again. Looked at every second, when
+ * macOS's Accessibility list changes, and when macOS disables the tap.
+ * NO: there is no tap (any more). Main thread.
+ */
+- (BOOL) omacvmKeepTap
+{
+    if (!eventsTap) {
+        return NO;
+    }
+    if (AXIsProcessTrusted()) {
+        return YES;
+    }
+    CGEventTapEnable(eventsTap, false);
+    CFMachPortInvalidate(eventsTap);   /* its run-loop source goes with it */
+    CFRelease(eventsTap);
+    eventsTap = NULL;
+    warn_report("Accessibility was taken away: the full-grab event tap is removed "
+                "(system shortcuts go to macOS until the VM is started again)");
+    return NO;
+}
+
+/*
  * Makes the target think all down keys are being released.
  * This prevents a stuck key problem, since we will not see
  * key up events for those keys after we have lost focus.

+/* Store the integer outputs written through int_out_tmp<first> (see
+ * int_temp): the float temporary's bits, as int or uint. Before the shader
+ * returns and before every vertex a geometry shader emits. Named after the
+ * TGSI register: ctx->outputs is sorted again after the body is written. */
+static void emit_int_output_stores(const struct dump_ctx *ctx,
+                                   struct vrend_glsl_strbufs *glsl_strbufs)
+{
+   static const char comps[] = "xyzw";
+   for (uint32_t i = 0; i < ctx->num_outputs; i++) {
+      const struct vrend_shader_io *output = &ctx->outputs[i];
+      if (!output->int_temp || !output->int_temp_written)
+         continue;
+      bool is_uint = output->type == VEC_UINT;
+      const char *cast = is_uint ? "floatBitsToUint" : "floatBitsToInt";
+      if (output->name == TGSI_SEMANTIC_COLOR) {
+         /* fsout_c<n>, uvec4 or ivec4 like the guest's colour buffer; only
+          * the written components (with framebuffer fetch the others keep
+          * the fetched value) */
+         if (output->int_temp_written == 0xf) {
+            emit_buff(glsl_strbufs, "%s = %s(int_out_tmp%d);\n", output->glsl_name, cast,
+                      output->first);
+         } else {
+            char mask[5] = "";
+            for (int c = 0, n = 0; c < 4; c++)
+               if (output->int_temp_written & (1 << c))
+                  mask[n++] = comps[c];
+            emit_buff(glsl_strbufs, "%s.%s = %s(int_out_tmp%d.%s);\n", output->glsl_name, mask,
+                      cast, output->first, mask);
+         }
+      } else {
+         /* gl_SampleMask[0] (the hosts' sample counts fit in one int; [1..3]
+          * are refused), gl_Layer, gl_ViewportIndex, gl_PrimitiveID: x;
+          * gl_FragStencilRefARB: y. The first written one if that is not. */
+         int c = output->name == TGSI_SEMANTIC_STENCIL ? 1 : 0;
+         if (!(output->int_temp_written & (1 << c))) {
+            c = 0;
+            while (!(output->int_temp_written & (1 << c)))
+               c++;
+         }
+         emit_buff(glsl_strbufs, "%s%s = %s(int_out_tmp%d.%c);\n", output->glsl_name,
+                   output->name == TGSI_SEMANTIC_SAMPLEMASK ? "[0]" : "", cast,
+                   output->first, comps[c]);
+      }
+   }
+}
